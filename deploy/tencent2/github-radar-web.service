[Unit]
Description=GitHub Radar read-only Web dashboard
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/home/xingzheng/data
ConditionPathIsMountPoint=/home/xingzheng/data

[Service]
Type=simple
User=github-radar
Group=github-radar
EnvironmentFile=/etc/github-radar/github-radar.env
ExecStart=/opt/github-radar/github-radar serve
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=tmpfs
ProtectSystem=strict
BindPaths=/home/xingzheng/data/github-radar
ReadWritePaths=/home/xingzheng/data/github-radar
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictRealtime=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
