# Copy to /etc/github-radar/github-radar.env and set mode 0640.
GITHUB_RADAR_GITHUB_TOKEN=
GITHUB_RADAR_DB_PATH=/var/lib/github-radar/github-radar.db
GITHUB_RADAR_EXPORT_DIR=/var/lib/github-radar/exports
GITHUB_RADAR_BACKUP_DIR=/var/lib/github-radar/backups
GITHUB_RADAR_DISCOVERY_CONFIG=/etc/github-radar/discovery.yaml
GITHUB_RADAR_TOPICS_CONFIG=/etc/github-radar/topics.yaml
GITHUB_RADAR_LISTEN_ADDR=127.0.0.1:8787
GITHUB_RADAR_TIMEZONE=Asia/Shanghai
GITHUB_RADAR_LOG_FORMAT=json
GITHUB_RADAR_EXPORT_RETENTION_DAYS=30
GITHUB_RADAR_BACKUP_RETENTION_DAYS=30

