{{define "content"}}
  <div class="home-primary-grid">
    <section class="home-health-rail" aria-labelledby="monitoring-summary">
      <div class="section-heading home-rail-heading">
        <div>
          <h2 id="monitoring-summary">{{t "home.summary"}}</h2>
          <p>{{t "home.summary_help"}}</p>
        </div>
      </div>

      <div class="home-coverage-summary">
        <dl class="home-coverage-metric">
          <div>
            <dt id="coverage-metric-label">{{t "metric.coverage"}}</dt>
            <dd>{{printf "%.1f%%" (coveragePercent .Dashboard.Coverage)}}</dd>
          </div>
          <div>
            <dt>{{t "metric.failed_today"}}</dt>
            <dd class="{{if gt .Dashboard.Coverage.Failed 0}}value-danger{{end}}">{{formatInt .Dashboard.Coverage.Failed}}</dd>
          </div>
        </dl>
        <p class="coverage-label">{{tf "home.snapshot_success" (formatInt .Dashboard.Coverage.Successful) (formatInt .Dashboard.Coverage.Target)}}</p>
        <progress max="100" value="{{printf "%.1f" (coveragePercent .Dashboard.Coverage)}}" aria-labelledby="coverage-metric-label">{{printf "%.1f%%" (coveragePercent .Dashboard.Coverage)}}</progress>
        <p class="home-snapshot-date muted">{{tf "home.snapshot_date" (formatDate .Dashboard.Coverage.Date)}}</p>
      </div>

      <dl class="home-growth-metrics">
        <div>
          <dt>{{t "metric.stars_today"}}</dt>
          <dd>{{formatSigned .Dashboard.NewStars1D}}</dd>
        </div>
        <div>
          <dt>{{t "metric.stars_7d"}}</dt>
          <dd>{{formatSigned .Dashboard.NewStars7D}}</dd>
        </div>
        <div>
          <dt>{{t "metric.stars_30d"}}</dt>
          <dd>{{formatSigned .Dashboard.NewStars30D}}</dd>
        </div>
      </dl>

      <dl class="home-inventory-metrics">
        <div>
          <dt>{{t "metric.repositories"}}</dt>
          <dd>{{formatInt .Dashboard.RepositoryTotal}}</dd>
        </div>
        <div>
          <dt>{{t "metric.active"}}</dt>
          <dd>{{formatInt .Dashboard.ActiveRepositoryTotal}}</dd>
        </div>
        <div>
          <dt>{{t "metric.topics"}}</dt>
          <dd>{{formatInt .Dashboard.TopicTotal}}</dd>
        </div>
      </dl>
      <p class="home-growth-note muted">{{t "home.growth_note"}}</p>
    </section>

    <section class="growth-section home-growth-panel" aria-labelledby="daily-star-growth">
      <div class="section-heading">
        <div>
          <h2 id="daily-star-growth">{{.GrowthChart.Title}}</h2>
          <p>{{.GrowthChart.Description}}</p>
        </div>
      </div>
      {{if .GrowthChart.HasComparable}}
        <figure class="growth-figure">
          <div class="growth-chart-scroll" role="region" aria-label="{{t "home.growth_chart_region"}}" tabindex="0">
          <svg class="growth-chart" viewBox="0 0 900 240" role="img" aria-labelledby="growth-chart-title growth-chart-description">
            <title id="growth-chart-title">{{.GrowthChart.Title}}</title>
            <desc id="growth-chart-description">{{.GrowthChart.Description}}</desc>
            <line class="growth-grid" x1="54" x2="880" y1="18" y2="18"></line>
            <line class="growth-grid" x1="54" x2="880" y1="194" y2="194"></line>
            <line class="growth-zero-axis" x1="54" x2="880" y1="{{.GrowthChart.AxisY}}" y2="{{.GrowthChart.AxisY}}"></line>
            {{if .GrowthChart.TopLabel}}<text class="growth-axis-label" x="44" y="22" text-anchor="end">{{.GrowthChart.TopLabel}}</text>{{end}}
            <text class="growth-axis-label" x="44" y="{{.GrowthChart.AxisY}}" dy="0.32em" text-anchor="end">{{.GrowthChart.ZeroLabel}}</text>
            {{if .GrowthChart.BottomLabel}}<text class="growth-axis-label" x="44" y="198" text-anchor="end">{{.GrowthChart.BottomLabel}}</text>{{end}}
            {{range .GrowthChart.Bars}}
              {{if .Missing}}
                <circle class="{{.Class}}" cx="{{.CenterX}}" cy="{{.Y}}" r="3"><title>{{.Tooltip}}</title></circle>
              {{else}}
                <rect class="{{.Class}}" x="{{.X}}" y="{{.Y}}" width="{{.Width}}" height="{{.Height}}" rx="1.5"><title>{{.Tooltip}}</title></rect>
              {{end}}
            {{end}}
            {{range .GrowthChart.DateLabels}}<text class="growth-date-label" x="{{.X}}" y="224" text-anchor="{{.Anchor}}">{{.Text}}</text>{{end}}
          </svg>
          </div>
          <figcaption>
            <p class="chart-scroll-hint">{{t "home.growth_scroll_hint"}}</p>
            <ul class="growth-legend" aria-label="{{t "home.growth_legend"}}">
              <li><span class="legend-sample legend-positive" aria-hidden="true"></span>{{t "home.growth_positive"}}</li>
              <li><span class="legend-sample legend-negative" aria-hidden="true"></span>{{t "home.growth_negative"}}</li>
              <li><span class="legend-sample legend-missing" aria-hidden="true"></span>{{t "home.growth_missing"}}</li>
            </ul>
          </figcaption>
        </figure>
      {{else}}
        <div class="empty-state">
          <h3>{{t "home.no_growth_history"}}</h3>
          <p>{{t "home.no_growth_history_help"}}</p>
        </div>
      {{end}}
      {{if .GrowthChart.HasPoints}}
        <details class="chart-details">
          <summary>{{t "home.growth_details"}}</summary>
          <div class="table-scroll" role="region" aria-label="{{t "home.growth_details_region"}}" tabindex="0">
            <table class="data-table growth-detail-table">
              <thead><tr><th scope="col">{{t "repository.date"}}</th><th scope="col" class="numeric">{{t "home.daily_delta"}}</th><th scope="col" class="numeric">{{t "home.comparable_repositories"}}</th><th scope="col" class="numeric">{{t "home.gap_spanning_repositories"}}</th></tr></thead>
              <tbody>
                {{range .Dashboard.GrowthHistory}}
                  <tr><td class="mono-value">{{formatDate .Date}}</td><td class="numeric metric-delta">{{formatSigned .Delta}}</td><td class="numeric">{{formatInt .ComparableRepositoryCount}}</td><td class="numeric">{{formatInt .GapSpanningRepositoryCount}}</td></tr>
                {{end}}
              </tbody>
            </table>
          </div>
        </details>
      {{end}}
    </section>
  </div>

  <div class="split-layout home-sections">
    <section aria-labelledby="fastest-repositories">
      <div class="section-heading">
        <div>
          <h2 id="fastest-repositories">{{t "home.fastest_repositories"}}</h2>
          <p>{{t "home.fastest_repositories_help"}}</p>
        </div>
        <a class="text-link" href="/repositories">{{t "home.view_all_repositories"}}</a>
      </div>
      {{if .Dashboard.FastestRepositories}}
        <ol class="rank-list">
          {{range .Dashboard.FastestRepositories}}
            <li>
              <div class="rank-position" aria-hidden="true"></div>
              <div class="rank-main">
                <a class="repo-name" href="/repositories/{{.ID}}" translate="no">{{.FullName}}</a>
                <p>{{if .PrimaryLanguage}}{{.PrimaryLanguage}}{{else}}{{t "home.language_unavailable"}}{{end}}{{with .Topics}} · <span translate="no">{{range $index, $topic := .}}{{if $index}}, {{end}}{{$topic.Name}}{{end}}</span>{{end}}</p>
              </div>
              <div class="rank-values">
                <strong>{{formatSigned .Delta1D}}</strong>
                <span>{{tf "home.total_stars" (formatIntPtr .CurrentStars)}}</span>
              </div>
            </li>
          {{end}}
        </ol>
      {{else}}
        <div class="empty-state">
          <h3>{{t "home.no_growth"}}</h3>
          <p>{{t "home.no_growth_help"}}</p>
        </div>
      {{end}}
    </section>

    <section aria-labelledby="recent-runs">
      <div class="section-heading">
        <div>
          <h2 id="recent-runs">{{t "home.recent_runs"}}</h2>
          <p>{{t "home.recent_runs_help"}}</p>
        </div>
        <a class="text-link" href="/runs">{{t "home.inspect_all_runs"}}</a>
      </div>
      {{if .Dashboard.RecentRuns}}
        <ul class="run-summary-list">
          {{range .Dashboard.RecentRuns}}
            <li>
              <span class="status-badge {{statusClass .Status}}"><span aria-hidden="true"></span>{{statusLabel .Status}}</span>
              <div>
                <strong>{{.JobType}}</strong>
                <time datetime="{{.StartedAt.Format "2006-01-02T15:04:05Z07:00"}}">{{formatDateTime .StartedAt}}</time>
              </div>
              <p><strong>{{formatInt .SuccessCount}}</strong> / {{formatInt .TargetCount}}</p>
            </li>
          {{end}}
        </ul>
      {{else}}
        <div class="empty-state">
          <h3>{{t "home.no_runs"}}</h3>
          <p>{{t "home.no_runs_help"}}</p>
        </div>
      {{end}}
    </section>
  </div>
{{end}}
