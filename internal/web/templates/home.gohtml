{{define "content"}}
<div class="dashboard-toolbar">
  <nav class="period-switch" aria-label="{{t "repositories.period_label"}}">{{range .TrendPeriods}}<a class="period-option {{if .Active}}is-active{{end}}" href="{{.URL}}" {{if .Active}}aria-current="page"{{end}}>{{.Label}}</a>{{end}}</nav>
  <form class="date-form" method="get" action="/">
    <input type="hidden" name="period" value="{{.Radar.Filter.WindowDays}}d">
    <input type="hidden" name="topic" value="{{.Radar.Filter.TopicSlug}}">
    <input type="hidden" name="lang" value="{{.Meta.Locale}}">
    {{if .Radar.Filter.OnlyFocus}}<input type="hidden" name="focus" value="1">{{end}}
    <label class="sr-only" for="dashboard-date">{{t "repositories.as_of_date"}}</label>
    <input type="date" id="dashboard-date" name="date" value="{{formatDate .Radar.AsOf}}">
    <button class="button button-secondary" type="submit">{{t "ui.view_date"}}</button>
  </form>
</div>
<nav class="category-tabs" aria-label="{{t "ui.category_filter"}}">{{range .Categories}}<a href="{{.URL}}" class="category-tab {{if .Active}}is-active{{end}}" {{if .Active}}aria-current="page"{{end}}>{{t .Label}}</a>{{end}}</nav>

<div class="dashboard-scope">
  <p>{{tf "dashboard.scope" (formatInt .Radar.Coverage.ScopeCount) (formatInt .Radar.Coverage.ComparableCount)}}<span>{{formatDate .Radar.BaselineDate}} → {{formatDate .Radar.AsOf}}</span></p>
  <a class="text-link" href="{{.NewProjectsURL}}">{{tf "dashboard.new_projects" (formatInt .Radar.Coverage.NewCount)}} {{template "icon-arrow"}}</a>
</div>

<div class="dashboard-leaderboards">
  {{range $board := .Boards}}
  <section class="surface leaderboard {{if .IsSlowdown}}leaderboard-secondary{{else}}leaderboard-primary{{end}}" aria-label="{{.Title}}">
    <div class="surface-heading"><div><h2>{{.Title}}</h2><p>{{.Description}}</p></div><a class="board-more" href="{{.URL}}" aria-label="{{tf "dashboard.view_board" .Title}}">{{template "icon-arrow"}}</a></div>
    {{if .Rows}}<ol class="leaderboard-list">
      {{range .Rows}}
      <li>
        <span class="leader-rank">{{.Rank}}</span>
        <div class="leader-identity">
          <a href="/repositories/{{.ID}}?date={{formatDate $.Radar.AsOf}}&amp;lang={{$.Meta.Locale}}" class="repo-name" translate="no">{{.FullName}}</a>
          {{if not $board.IsSlowdown}}<p class="leader-description">{{if .Description}}{{.Description}}{{else}}{{t "ui.no_description"}}{{end}}</p>{{end}}
          <p class="leader-metadata">{{if .PrimaryLanguage}}<span>{{.PrimaryLanguage}}</span> · {{end}}★ {{formatIntPtr .CurrentStars}}</p>
          {{if not $board.IsSlowdown}}<svg class="leader-bar" viewBox="0 0 100 3" preserveAspectRatio="none" aria-hidden="true"><rect width="{{.BarWidth}}" height="3" rx="1.5"/></svg>{{end}}
        </div>
        <div class="leader-value">
          <strong class="{{deltaClass .StarDelta}}">{{formatSigned .StarDelta}}</strong>
          {{if $board.IsSlowdown}}<small>{{formatSigned .PreviousDelta}} → {{formatSigned .StarDelta}}</small>{{else}}<small>{{formatPercent .GrowthRate}}</small>{{end}}
        </div>
      </li>
      {{end}}
    </ol>{{else}}<div class="board-empty"><p>{{if .IsSlowdown}}{{t "dashboard.no_slowdown"}}{{else}}{{t "dashboard.no_growth"}}{{end}}</p><span>{{t "dashboard.empty_help"}}</span></div>{{end}}
  </section>
  {{end}}
</div>
<details class="method-note"><summary>{{t "ui.methodology"}}</summary><p>{{t "dashboard.methodology"}}</p><p>{{tf "ui.slowdown_window" (formatDate .Radar.PreviousDate) (formatDate .Radar.BaselineDate) (formatDate .Radar.AsOf)}}</p></details>
{{end}}
