{{define "content"}}
<div class="dashboard-toolbar">
  <nav class="period-switch" aria-label="{{t "repositories.period_label"}}">{{range .TrendPeriods}}<a class="period-option {{if .Active}}is-active{{end}}" href="{{.URL}}" {{if .Active}}aria-current="page"{{end}}>{{.Label}}</a>{{end}}</nav>
  <form class="date-form" method="get" action="/">
    <input type="hidden" name="period" value="{{.Radar.Filter.WindowDays}}d">
    <input type="hidden" name="topic" value="{{.Radar.Filter.TopicSlug}}">
    <label class="sr-only" for="dashboard-date">{{t "repositories.as_of_date"}}</label>
    <input type="date" id="dashboard-date" name="date" value="{{formatDate .Radar.AsOf}}">
    <button class="button button-secondary" type="submit">{{t "ui.view_date"}}</button>
  </form>
</div>
<nav class="category-tabs" aria-label="{{t "ui.category_filter"}}">{{range .Categories}}<a href="{{.URL}}" class="category-tab {{if .Active}}is-active{{end}}" {{if .Active}}aria-current="page"{{end}}>{{t .Label}}</a>{{end}}</nav>

<div class="radar-stat-row" aria-label="{{t "ui.window_summary"}}">
  <div><span class="stat-label">{{t "ui.up_projects"}}</span><div class="stat-reading"><strong>{{formatInt .Radar.Coverage.UpCount}}</strong><span class="stat-marker positive">↗</span></div><p>{{t "ui.up_note"}}</p></div>
  <div><span class="stat-label">{{t "ui.flat_projects"}}</span><div class="stat-reading"><strong>{{formatInt .Radar.Coverage.FlatCount}}</strong><span class="stat-marker neutral">→</span></div><p>{{t "ui.flat_note"}}</p></div>
  <div><span class="stat-label">{{t "ui.slowdown"}}</span><div class="stat-reading"><strong>{{formatInt .Radar.Coverage.SlowingCount}}</strong><span class="stat-marker negative">↘</span></div><p>{{tf "ui.slowdown_note" (formatInt .Radar.Coverage.MomentumComparableCount)}}</p></div>
  <div><span class="stat-label">{{t "ui.new_today"}}</span><div class="stat-reading"><strong>{{formatInt .Radar.Coverage.NewCount}}</strong><a href="{{.NewProjectsURL}}" aria-label="{{t "ui.view_discoveries"}}">{{template "icon-arrow"}}</a></div><p>{{t "ui.new_note"}}</p></div>
</div>

<div class="dashboard-chart-grid">
  <section class="surface trend-surface" aria-labelledby="radar-chart-title">
    <div class="surface-heading"><div><h2 id="radar-chart-title">{{t "ui.chart_title"}}</h2><p>{{tf "ui.chart_subtitle" (formatInt .ChartCohort)}}</p></div><span class="chart-change {{floatDeltaClass .ChartChange}}">{{formatPercent .ChartChange}}</span></div>
    {{if .RadarChart.HasData}}
      <div class="chart-frame radar-chart-frame">
        <div class="chart-y-label chart-y-top">{{.RadarChart.MaxLabel}}</div><div class="chart-y-label chart-y-bottom">{{.RadarChart.MinLabel}}</div>
        <svg class="line-chart" viewBox="0 0 800 224" role="img" aria-label="{{t "ui.chart_help"}}" preserveAspectRatio="none">
          <line class="chart-grid" x1="16" y1="14" x2="784" y2="14"/><line class="chart-grid" x1="16" y1="76" x2="784" y2="76"/><line class="chart-grid" x1="16" y1="137" x2="784" y2="137"/><line class="chart-grid" x1="16" y1="198" x2="784" y2="198"/>
          {{range .RadarChart.Segments}}<polyline class="chart-line" points="{{.Points}}"/>{{end}}
          {{range .RadarChart.Points}}<circle class="chart-dot" cx="{{.X}}" cy="{{.Y}}" r="3"><title>{{.Label}} · {{.Value}}</title></circle>{{end}}
        </svg>
        <div class="chart-x-label chart-x-start">{{.RadarChart.StartLabel}}</div><div class="chart-x-label chart-x-end">{{.RadarChart.EndLabel}}</div>
      </div>
    {{else}}<div class="chart-empty"><span>{{template "icon-chart"}}</span><h3>{{t "ui.no_trend"}}</h3><p>{{t "ui.no_trend_help"}}</p></div>{{end}}
    <details class="chart-details"><summary>{{t "ui.chart_method"}}</summary><p>{{t "ui.chart_help"}}</p><div class="table-scroll"><table class="data-table compact-table"><thead><tr><th>{{t "repository.date"}}</th><th class="numeric">{{t "ui.index"}}</th></tr></thead><tbody>{{range .RadarChart.Observations}}<tr><td>{{.Label}}</td><td class="numeric">{{if .Missing}}{{t "page.not_available"}}{{else}}{{.Value}}{{end}}</td></tr>{{end}}</tbody></table></div></details>
  </section>
  <section class="surface distribution-surface" aria-labelledby="distribution-title">
    <div class="surface-heading"><div><h2 id="distribution-title">{{t "ui.direction_title"}}</h2><p>{{t "ui.direction_help"}}</p></div></div>
    <div class="direction-donut">
      <svg viewBox="0 0 200 200" aria-label="{{tf "ui.direction_aria" (formatInt .Radar.Coverage.UpCount) (formatInt .Radar.Coverage.FlatCount) (formatInt .Radar.Coverage.DownCount)}}" role="img">
        <circle class="direction-track" cx="100" cy="100" r="78" fill="none" stroke-width="15"/>
        {{range .DirectionSegments}}<circle class="{{.Class}}" cx="100" cy="100" r="78" fill="none" stroke-width="15" pathLength="100" stroke-dasharray="{{.Dash}}" stroke-dashoffset="{{.Offset}}" transform="rotate(-90 100 100)"/>{{end}}
      </svg>
      <div><strong>{{formatInt .Radar.Coverage.ComparableCount}}</strong><span>{{t "ui.comparable"}}</span></div>
    </div>
    <dl class="direction-legend">
      <div><dt><i class="legend-dot positive"></i>{{t "ui.growing"}}</dt><dd>{{formatInt .Radar.Coverage.UpCount}}</dd></div>
      <div><dt><i class="legend-dot neutral"></i>{{t "ui.flat"}}</dt><dd>{{formatInt .Radar.Coverage.FlatCount}}</dd></div>
      <div><dt><i class="legend-dot negative"></i>{{t "ui.declining"}}</dt><dd>{{formatInt .Radar.Coverage.DownCount}}</dd></div>
    </dl>
    <p class="coverage-footnote">{{tf "ui.coverage_note" (formatInt .Radar.Coverage.ObservedCount) (formatInt .Radar.Coverage.ScopeCount)}} · <a href="/runs">{{t "ui.inspect_collection"}}</a></p>
  </section>
</div>

<div class="section-heading leaderboard-heading"><div><h2>{{t "ui.watch_movement"}}</h2><p>{{tf "ui.comparison_dates" (formatDate .Radar.BaselineDate) (formatDate .Radar.AsOf)}}</p></div><a class="text-link" href="/repositories">{{t "ui.all_projects"}} {{template "icon-arrow"}}</a></div>
<div class="leaderboard-grid">
  {{range $board := .Boards}}
  <section class="surface leaderboard" aria-label="{{.Title}}">
    <div class="surface-heading"><div><h3><span class="board-dot {{.Tone}}"></span>{{.Title}}</h3><p>{{.Description}}</p></div><a class="board-more" href="{{.URL}}" aria-label="{{.Title}}">{{template "icon-arrow"}}</a></div>
    {{if .Rows}}<ol class="leaderboard-list">
      {{range .Rows}}
      <li><span class="leader-rank">{{.Rank}}</span><div class="leader-identity"><a href="/repositories/{{.ID}}" class="repo-name" translate="no">{{.FullName}}</a><p>{{if .PrimaryLanguage}}<span>{{.PrimaryLanguage}}</span> · {{end}}★ {{formatIntPtr .CurrentStars}}</p><svg class="leader-bar" viewBox="0 0 100 3" preserveAspectRatio="none" aria-hidden="true"><rect width="{{.BarWidth}}" height="3" rx="1.5"/></svg></div><div class="leader-value"><strong class="{{deltaClass .StarDelta}}">{{formatSigned .StarDelta}}</strong>{{if $board.IsSlowdown}}<small class="metric-negative">{{formatSigned .PreviousDelta}} → {{formatSigned .StarDelta}}</small>{{else}}<small>{{formatPercent .GrowthRate}}</small>{{end}}</div></li>
      {{end}}
    </ol>{{else}}<div class="board-empty">{{template "icon-chart"}}<p>{{t "ui.no_board_data"}}</p></div>{{end}}
  </section>
  {{end}}
</div>
<details class="method-note"><summary>{{t "ui.methodology"}}</summary><p>{{t "ui.methodology_help"}}</p><p>{{tf "ui.slowdown_window" (formatDate .Radar.PreviousDate) (formatDate .Radar.BaselineDate) (formatDate .Radar.AsOf)}}</p></details>
{{end}}
