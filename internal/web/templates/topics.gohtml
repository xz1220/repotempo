{{define "page-meta"}}
  <nav class="breadcrumb" aria-label="{{t "breadcrumb.label"}}">
    <a class="breadcrumb-link" href="/repositories"><span aria-hidden="true">←</span><span>{{t "nav.repositories"}}</span></a>
  </nav>
{{end}}

{{define "content"}}
  <section class="topic-coverage-summary" aria-labelledby="topic-coverage-title">
    <div>
      <h2 id="topic-coverage-title">{{t "topics.coverage_title"}}</h2>
      <p>{{t "topics.coverage_help"}}</p>
    </div>
    <dl>
      <div><dt>{{t "topics.coverage_total"}}</dt><dd>{{formatInt .Topics.Classification.RepositoryCount}}</dd></div>
      <div><dt>{{t "topics.coverage_classified"}}</dt><dd>{{formatInt .Topics.Classification.ClassifiedCount}}</dd></div>
      <div><dt>{{t "topics.coverage_unclassified"}}</dt><dd><a href="/repositories?topic=__unclassified">{{formatInt .Topics.Classification.UnclassifiedCount}}</a></dd></div>
      <div><dt>{{t "topics.coverage_percent"}}</dt><dd>{{formatPercent .Topics.Classification.Percent}}</dd></div>
    </dl>
  </section>


<div class="category-catalog">
{{range .CategoryCards}}<article class="surface category-card">
  <div class="category-card-heading"><a class="topic-name" href="/topics/{{.Slug}}">{{.Name}}</a><span>{{tf "repositories.count" (formatInt .Count)}}</span></div>
  <p>{{.Description}}</p>
  {{if .Children}}<div class="tag-list">{{range .Children}}<a class="tag" href="/repositories?topic={{.Slug}}">{{.Name}}</a>{{end}}</div>{{end}}
  <a class="text-link" href="/repositories?topic={{.Slug}}">{{t "ui.category_library"}} {{template "icon-arrow"}}</a>
</article>{{end}}
</div>
<details class="method-note"><summary>{{t "ui.category_rules"}}</summary><p>{{t "ui.category_rules_help"}}</p></details>
  <details class="category-growth-details"><summary>{{t "ui.category_metrics"}}</summary><section class="page-drilldown" aria-labelledby="topic-list">
    <div class="section-heading result-heading">
      <div><h2 id="topic-list">{{tf "topics.count" (formatInt (len .Topics.Items))}}</h2><p>{{t "topics.boundary_help"}}</p></div>
    </div>
    {{if .Topics.Items}}
      <div class="table-scroll" role="region" aria-label="{{t "topics.metrics_region"}}" tabindex="0">
        <table class="data-table topic-table">
          <thead><tr><th scope="col">{{t "topics.topic"}}</th><th scope="col">{{t "topics.parent"}}</th><th scope="col" class="numeric">{{t "metric.repositories"}}</th><th scope="col" class="numeric">{{t "repositories.stars"}}</th><th scope="col" class="numeric">{{t "metric.one_day"}}</th><th scope="col" class="numeric">{{t "metric.seven_days"}}</th><th scope="col" class="numeric">{{t "metric.thirty_days"}}</th></tr></thead>
          <tbody>
            {{range .Topics.Items}}
              <tr>
                <td><a class="topic-name" href="/topics/{{.Slug}}" >{{topicName .Slug .Name}}</a>{{if .Description}}<p class="cell-description">{{.Description}}</p>{{end}}</td>
                <td>{{if .ParentName}}<a class="text-link" href="/topics/{{.ParentSlug}}" >{{topicName .ParentSlug .ParentName}}</a>{{else}}<span class="muted">{{t "topics.top_level"}}</span>{{end}}</td>
                <td class="numeric">{{formatInt .RepositoryCount}}</td>
                <td class="numeric metric-value">{{formatIntPtr .CurrentStars}}</td>
                <td class="numeric metric-delta">{{formatSigned .Delta1D}}<span class="cell-secondary">{{tf "topics.comparable_short" (formatInt .Comparable1D) (formatInt .RepositoryCount)}}</span></td>
                <td class="numeric metric-delta">{{formatSigned .Delta7D}}<span class="cell-secondary">{{tf "topics.comparable_short" (formatInt .Comparable7D) (formatInt .RepositoryCount)}}</span></td>
                <td class="numeric metric-delta">{{formatSigned .Delta30D}}<span class="cell-secondary">{{tf "topics.comparable_short" (formatInt .Comparable30D) (formatInt .RepositoryCount)}}</span></td>
              </tr>
            {{end}}
          </tbody>
        </table>
      </div>
    {{else}}
      <div class="empty-state"><h3>{{t "topics.no_topics"}}</h3><p>{{t "topics.no_topics_help"}}</p></div>
    {{end}}
  </section></details>
{{end}}
