{{define "content"}}
  <section aria-labelledby="topic-list">
    <div class="section-heading result-heading">
      <div><h2 id="topic-list">{{tf "topics.count" (formatInt (len .Topics.Items))}}</h2><p>{{t "topics.boundary_help"}}</p></div>
    </div>
    {{if .Topics.Items}}
      <div class="table-scroll" role="region" aria-label="{{t "topics.metrics_region"}}" tabindex="0">
        <table class="data-table topic-table">
          <thead><tr><th scope="col">{{t "topics.topic"}}</th><th scope="col">{{t "topics.parent"}}</th><th scope="col" class="numeric">{{t "metric.repositories"}}</th><th scope="col" class="numeric">{{t "repositories.stars"}}</th><th scope="col" class="numeric">{{t "metric.one_day"}}</th><th scope="col" class="numeric">{{t "metric.seven_days"}}</th><th scope="col" class="numeric">{{t "metric.thirty_days"}}</th></tr></thead>
          <tbody>
            {{range .Topics.Items}}
              <tr>
                <td><a class="topic-name" href="/topics/{{.Slug}}">{{.Name}}</a>{{if .Description}}<p class="cell-description">{{.Description}}</p>{{end}}</td>
                <td>{{if .ParentName}}<a class="text-link" href="/topics/{{.ParentSlug}}">{{.ParentName}}</a>{{else}}<span class="muted">{{t "topics.top_level"}}</span>{{end}}</td>
                <td class="numeric">{{formatInt .RepositoryCount}}</td>
                <td class="numeric metric-value">{{formatIntPtr .CurrentStars}}</td>
                <td class="numeric metric-delta">{{formatSigned .Delta1D}}</td>
                <td class="numeric metric-delta">{{formatSigned .Delta7D}}</td>
                <td class="numeric metric-delta">{{formatSigned .Delta30D}}</td>
              </tr>
            {{end}}
          </tbody>
        </table>
      </div>
    {{else}}
      <div class="empty-state"><h3>{{t "topics.no_topics"}}</h3><p>{{t "topics.no_topics_help"}}</p></div>
    {{end}}
  </section>
{{end}}
