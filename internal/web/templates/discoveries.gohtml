{{define "content"}}
  <section aria-labelledby="source-coverage">
    <div class="section-heading"><div><h2 id="source-coverage">{{t "discoveries.source_coverage"}}</h2><p>{{t "discoveries.source_coverage_help"}}</p></div></div>
    {{if .Discoveries.Sources}}
      <dl class="source-strip">
        {{range .Discoveries.Sources}}
          <div><dt>{{sourceLabel .Source}}</dt><dd>{{formatInt .RepositoryCount}}</dd><p>{{tf "discoveries.last_run" (formatDatePtr .LastRunAt)}}</p></div>
        {{end}}
      </dl>
    {{else}}
      <div class="empty-state"><h3>{{t "discoveries.no_discoveries"}}</h3><p>{{t "discoveries.no_discoveries_help"}}</p></div>
    {{end}}
  </section>

  <section aria-labelledby="search-profiles">
    <div class="section-heading"><div><h2 id="search-profiles">{{t "discoveries.search_profiles"}}</h2><p>{{t "discoveries.search_profiles_help"}}</p></div></div>
    {{if .Discoveries.Profiles}}
      <div class="table-scroll" role="region" aria-label="{{t "discoveries.profile_outcomes"}}" tabindex="0">
        <table class="data-table">
          <thead><tr><th scope="col">{{t "discoveries.profile"}}</th><th scope="col" class="numeric">{{t "discoveries.new_valid"}}</th><th scope="col" class="numeric">{{t "discoveries.candidates"}}</th><th scope="col">{{t "discoveries.completeness"}}</th><th scope="col" class="numeric">{{t "discoveries.query_splits"}}</th><th scope="col">{{t "discoveries.last_run_column"}}</th></tr></thead>
          <tbody>
            {{range .Discoveries.Profiles}}
              <tr><td class="mono-value">{{.Name}}</td><td class="numeric metric-value">{{formatInt .NewRepositories}}</td><td class="numeric">{{formatInt .CandidateCount}}</td><td>{{if .IncompleteResults}}<span class="status-badge status-warning"><span aria-hidden="true"></span>{{t "discoveries.incomplete"}}</span>{{else}}<span class="status-badge status-success"><span aria-hidden="true"></span>{{t "discoveries.complete"}}</span>{{end}}</td><td class="numeric">{{formatInt .QuerySplitCount}}</td><td>{{formatTimePtr .LastRunAt}}</td></tr>
            {{end}}
          </tbody>
        </table>
      </div>
    {{else}}
      <div class="empty-state"><h3>{{t "discoveries.no_profiles"}}</h3><p>{{t "discoveries.no_profiles_help"}}</p></div>
    {{end}}
  </section>
{{end}}
