{{define "content"}}
<div class="discovery-datebar">
  <div><h2>{{formatDate .Repositories.Filter.AsOf}}</h2><p>{{tf "repositories.count" (formatInt .Repositories.Total)}} · {{t "ui.auto_tracking"}}</p></div>
  <form class="date-form" action="/discoveries" method="get"><input type="hidden" name="lang" value="{{.Meta.Locale}}"><input type="hidden" name="topic" value="{{.Repositories.Filter.TopicSlug}}"><label class="sr-only" for="discovery-date">{{t "ui.discovered_on"}}</label><input id="discovery-date" type="date" name="date" value="{{formatDate .Repositories.Filter.AsOf}}"><button class="button button-secondary" type="submit">{{t "ui.view_date"}}</button></form>
</div>
<nav class="category-tabs" aria-label="{{t "ui.category_filter"}}">{{range .Categories}}<a href="{{.URL}}" class="category-tab {{if .Active}}is-active{{end}}" {{if .Active}}aria-current="page"{{end}}>{{t .Label}}</a>{{end}}</nav>
{{if .Repositories.Items}}
<div class="discovery-grid">
{{range .Repositories.Items}}<article class="surface discovery-card">
  <div class="discovery-card-header"><span class="repo-avatar">{{template "icon-grid"}}</span><span class="new-badge">{{t "repositories.new_badge"}}</span></div>
  <a class="repo-name" href="/repositories/{{.ID}}" translate="no">{{.FullName}}</a>
  <p class="repository-description">{{if .Description}}{{.Description}}{{else}}{{t "ui.no_description"}}{{end}}</p>
  <div class="discovery-evidence"><span>★ {{if .CurrentStars}}{{formatIntPtr .CurrentStars}}{{else}}{{formatIntPtr .LastObservedStars}}{{end}}</span>{{if .PrimaryLanguage}}<span>{{.PrimaryLanguage}}</span>{{end}}<span>{{sourceLabel .FirstSeenSource}}</span></div>
  <div class="tag-list">{{range .Topics}}<a class="tag" href="/repositories?topic={{.Slug}}">{{topicName .Slug .Name}}</a>{{else}}<span class="tag tag-muted">{{t "category.__unclassified"}}</span>{{end}}</div>
  <div class="discovery-card-footer"><span>{{if .GitHubCreatedAt}}{{t "ui.created_on"}} {{formatDatePtr .GitHubCreatedAt}}{{else}}{{t "ui.created_unknown"}}{{end}}</span><a class="text-link" href="/repositories/{{.ID}}">{{t "ui.details"}} {{template "icon-arrow"}}</a></div>
</article>{{end}}
</div>
<nav class="cursor-pagination" aria-label="{{t "pagination.label"}}"><p>{{tf "repositories.page_summary" (formatInt (len .Repositories.Items)) (formatInt .Repositories.Total)}}</p><div>{{if .Repositories.Filter.AfterID}}<a class="button button-secondary" href="{{.Repositories.FirstPageURL}}">{{t "ui.first_page"}}</a>{{end}}{{if .Repositories.NextCursor}}<a class="button button-secondary" href="{{.Repositories.NextCursor}}" rel="next">{{t "pagination.next"}} {{template "icon-arrow"}}</a>{{end}}</div></nav>
{{else}}<div class="empty-state"><h3>{{t "ui.no_discoveries"}}</h3><p>{{t "ui.no_discoveries_help"}}</p><a class="button button-primary" href="/watch/new">{{template "icon-plus"}}{{t "ui.add_project"}}</a></div>{{end}}
<p class="discovery-explanation">{{t "ui.discovery_explanation"}}</p>
{{end}}
