{{define "content"}}
  <section aria-labelledby="topic-summary">
    <div class="section-heading entity-section-heading">
      <div>
        <h2 id="topic-summary" class="sr-only">{{t "topic.summary"}}</h2>
        {{if .Topic.Topic.Description}}<p class="entity-description">{{.Topic.Topic.Description}}</p>{{end}}
        {{if .Topic.Topic.ParentName}}<p class="parent-link">{{t "topic.part_of"}} <a class="text-link" href="/topics/{{.Topic.Topic.ParentSlug}}">{{.Topic.Topic.ParentName}}</a></p>{{end}}
      </div>
      <form class="leader-toggle" method="get" action="/topics/{{.Topic.Topic.Slug}}">
        <label><input type="checkbox" name="exclude_leader" value="true" {{if .Topic.ExcludeLeader}}checked{{end}} data-submit-on-change> {{t "topic.exclude_leader"}}</label>
        <noscript><button class="button button-secondary" type="submit">{{t "topic.update_metrics"}}</button></noscript>
      </form>
    </div>
    {{if and .Topic.ExcludeLeader .Topic.ExcludedLeaderFullName}}<p class="filter-note">{{tf "topic.excludes" .Topic.ExcludedLeaderFullName}}</p>{{end}}
    <dl class="metric-strip topic-metrics">
      <div><dt>{{t "metric.repositories"}}</dt><dd>{{formatInt .Topic.Topic.RepositoryCount}}</dd></div>
      <div><dt>{{t "metric.total_stars"}}</dt><dd>{{formatIntPtr .Topic.Topic.CurrentStars}}</dd></div>
      <div><dt>{{t "metric.one_day"}}</dt><dd>{{formatSigned .Topic.Topic.Delta1D}}</dd></div>
      <div><dt>{{t "metric.seven_days"}}</dt><dd>{{formatSigned .Topic.Topic.Delta7D}}</dd></div>
      <div><dt>{{t "metric.thirty_days"}}</dt><dd>{{formatSigned .Topic.Topic.Delta30D}}</dd></div>
      <div><dt>{{t "topic.top_share"}}</dt><dd>{{formatPercent .Topic.ConcentrationPercent}}</dd></div>
    </dl>
  </section>

  {{template "chart" .TopicChart}}

  <section aria-labelledby="topic-repositories">
    <div class="section-heading"><div><h2 id="topic-repositories">{{t "topic.fastest_repositories"}}</h2><p>{{t "topic.fastest_repositories_help"}}</p></div></div>
    {{if .Topic.Repositories}}
      <div class="table-scroll" role="region" aria-label="{{t "topic.metrics_region"}}" tabindex="0">
        <table class="data-table">
          <thead><tr><th scope="col">{{t "repositories.repository"}}</th><th scope="col" class="numeric">{{t "repositories.stars"}}</th><th scope="col" class="numeric">{{t "metric.one_day"}}</th><th scope="col" class="numeric">{{t "metric.seven_days"}}</th><th scope="col" class="numeric">{{t "metric.thirty_days"}}</th><th scope="col">{{t "repositories.monitoring"}}</th></tr></thead>
          <tbody>{{range .Topic.Repositories}}<tr><td><a class="repo-name" href="/repositories/{{.ID}}">{{.FullName}}</a>{{if .Description}}<p class="cell-description">{{.Description}}</p>{{end}}</td><td class="numeric metric-value">{{formatIntPtr .CurrentStars}}</td><td class="numeric metric-delta">{{formatSigned .Delta1D}}</td><td class="numeric metric-delta">{{formatSigned .Delta7D}}</td><td class="numeric metric-delta">{{formatSigned .Delta30D}}</td><td><span class="status-badge {{statusClass .MonitoringStatus}}"><span aria-hidden="true"></span>{{statusLabel .MonitoringStatus}}</span></td></tr>{{end}}</tbody>
        </table>
      </div>
    {{else}}
      <div class="empty-state"><h3>{{t "topic.no_repositories"}}</h3><p>{{t "topic.no_repositories_help"}}</p></div>
    {{end}}
  </section>
{{end}}
