{{define "page-meta"}}
  <nav class="breadcrumb" aria-label="{{t "breadcrumb.label"}}">
    <a class="breadcrumb-link" href="{{.LibraryReturnURL}}" data-library-return><span aria-hidden="true">←</span><span>{{t "nav.repositories"}}</span></a>
  </nav>
{{end}}

{{define "content"}}
  <section class="entity-header" aria-labelledby="repository-overview">
    <div>
      <h2 id="repository-overview" class="sr-only">{{t "repository.overview"}}</h2>
      <div class="entity-actions">
        {{with githubURL .Repository.Repository.HTMLURL}}<a class="button button-secondary" href="{{.}}" target="_blank" rel="noopener noreferrer">{{t "repository.open_github"}}</a>{{end}}
        <span class="status-badge {{statusClass .Repository.Repository.MonitoringStatus}}"><span aria-hidden="true"></span>{{statusLabel .Repository.Repository.MonitoringStatus}}</span>
        {{if .Repository.Repository.IsFocus}}<span class="new-badge">{{t "ui.my_watchlist"}}</span>{{end}}
        {{if ne .Repository.Repository.GitHubStatus "active"}}<span class="status-badge {{statusClass .Repository.Repository.GitHubStatus}}"><span aria-hidden="true"></span>{{tf "repository.github_status" (statusLabel .Repository.Repository.GitHubStatus)}}</span>{{end}}
      </div>
      {{if and .Repository.Repository.Description .Repository.Analysis}}<p class="entity-description">{{.Repository.Repository.Description}}</p>{{end}}
    </div>

    <section class="repository-analysis" aria-labelledby="repository-analysis-title">
      <div class="section-heading compact">
        <div><h2 id="repository-analysis-title">{{t "ui.about_project"}}</h2><p>{{if .Repository.Analysis}}{{t "ui.analysis_available"}}{{else}}{{t "ui.github_description"}}{{end}}</p></div>
      </div>
      {{with .Repository.Analysis}}
        {{if .SummaryZH}}<p class="analysis-summary" lang="zh-CN">{{.SummaryZH}}</p>{{end}}
        <div class="analysis-columns">
          {{if .KeyPoints}}<div><h3>{{t "repository.analysis_key_points"}}</h3><ul>{{range .KeyPoints}}<li lang="zh-CN">{{.}}</li>{{end}}</ul></div>{{end}}
          {{if .UseCases}}<div><h3>{{t "repository.analysis_use_cases"}}</h3><ul>{{range .UseCases}}<li lang="zh-CN">{{.}}</li>{{end}}</ul></div>{{end}}
        </div>
        {{if .TechnicalNotes}}<details class="analysis-notes"><summary>{{t "repository.analysis_technical_notes"}}</summary><p lang="zh-CN">{{.TechnicalNotes}}</p></details>{{end}}
        <p class="analysis-provenance">{{if eq .Source "legacy_research"}}{{t "feed.legacy_source"}} · {{t "feed.legacy_date"}}{{else}}{{tf "repository.analysis_provenance" .Source .Revision (formatDate .AnalyzedAt)}}{{end}}{{if .Model}} · <span translate="no">{{.Model}}</span>{{end}}</p>
      {{else}}
        <div class="analysis-pending">
          {{if .Repository.Repository.Description}}<p>{{.Repository.Repository.Description}}</p>{{else}}<p>{{t "repository.analysis_no_description"}}</p>{{end}}
          {{if .Repository.Repository.ManualNote}}<p class="watch-note">{{t "ui.watch_reason"}}{{.Repository.Repository.ManualNote}}</p>{{end}}
          {{with githubURL .Repository.Repository.HTMLURL}}<a class="text-link readme-link" href="{{.}}#readme" target="_blank" rel="noopener noreferrer">{{t "ui.read_readme"}} ↗</a>{{end}}
        </div>
      {{end}}
    </section>

    <dl class="metric-strip repository-metrics">
      <div><dt>{{t "metric.current_stars"}}</dt><dd>{{formatIntPtr .Repository.Repository.CurrentStars}}</dd></div>
      <div><dt>{{t "metric.one_day"}}</dt><dd>{{formatSigned .Repository.Repository.Delta1D}}</dd></div>
      <div><dt>{{t "metric.seven_days"}}</dt><dd>{{formatSigned .Repository.Repository.Delta7D}}</dd></div>
      <div><dt>{{t "metric.thirty_days"}}</dt><dd>{{formatSigned .Repository.Repository.Delta30D}}</dd></div>
    </dl>
  </section>

  <section class="evidence-grid" aria-labelledby="collection-evidence">
    <div>
      <div class="section-heading compact"><div><h2 id="collection-evidence">{{t "repository.collection_evidence"}}</h2><p>{{t "repository.collection_evidence_help"}}</p></div></div>
      <dl class="definition-list">
        <div><dt>{{t "repository.first_seen"}}</dt><dd>{{formatDateTime .Repository.Repository.FirstSeenAt}}</dd></div>
        <div><dt>{{t "repository.first_source"}}</dt><dd>{{sourceLabel .Repository.Repository.FirstSeenSource}}</dd></div>
        {{if .Repository.Repository.DiscoverySources}}<div><dt>{{t "repository.discovery_sources"}}</dt><dd>{{range $index, $source := .Repository.Repository.DiscoverySources}}{{if $index}} · {{end}}{{sourceLabel $source}}{{end}}</dd></div>{{end}}
        <div><dt>{{t "repository.first_profile"}}</dt><dd {{if .Repository.Repository.FirstSeenProfile}}translate="no"{{end}}>{{if .Repository.Repository.FirstSeenProfile}}{{.Repository.Repository.FirstSeenProfile}}{{else}}{{t "page.not_available"}}{{end}}</dd></div>
        <div><dt>{{t "repository.valid_history"}}</dt><dd>{{formatDatePtr .Repository.ValidFrom}}</dd></div>
        <div><dt>{{t "repository.primary_language"}}</dt><dd>{{if .Repository.Repository.PrimaryLanguage}}{{.Repository.Repository.PrimaryLanguage}}{{else}}{{t "page.not_available"}}{{end}}</dd></div>
        <div>
          <dt>{{t "tags.filter"}}</dt>
          <dd><div class="tag-list">{{range .DetailTags.Visible}}<a class="tag" href="{{.URL}}">{{.Label}}</a>{{else}}<span class="muted">{{t "tags.none"}}</span>{{end}}{{range .DetailTags.More}}<a class="tag" href="{{.URL}}">{{.Label}}</a>{{end}}</div></dd>
        </div>
      </dl>
    </div>
    <div>
      <div class="section-heading compact"><div><h2>{{t "repository.name_history"}}</h2><p>{{t "repository.name_history_help"}}</p></div></div>
      {{if .Repository.PreviousNames}}
        <ul class="plain-list mono-list" translate="no">{{range .Repository.PreviousNames}}<li>{{.}}</li>{{end}}</ul>
      {{else}}
        <p class="empty-inline">{{t "repository.no_name_history"}}</p>
      {{end}}
    </div>
  </section>

  {{template "chart" .StarChart}}
  {{if .RankChart.HasData}}<details class="supporting-chart"><summary>{{t "ui.oss_history"}}</summary>
    {{template "chart" .RankChart}}
  </details>{{end}}

  <div class="split-layout detail-sections">
    <section aria-labelledby="failed-observations">
      <div class="section-heading compact"><div><h2 id="failed-observations">{{t "repository.failed_observations"}}</h2><p>{{t "repository.failed_observations_help"}}</p></div></div>
      {{if .Repository.FailedDates}}
        <div class="table-scroll" role="region" aria-label="{{t "repository.failed_observations_region"}}" tabindex="0">
          <table class="data-table compact-table">
            <thead><tr><th scope="col">{{t "repository.date"}}</th><th scope="col">HTTP</th><th scope="col">{{t "repository.error"}}</th></tr></thead>
            <tbody>{{range .Repository.FailedDates}}<tr><td>{{formatDate .Date}}</td><td>{{if .HTTPStatus}}{{.HTTPStatus}}{{else}}{{t "page.not_available"}}{{end}}</td><td>{{if .ErrorCode}}{{.ErrorCode}}{{else}}{{statusLabel .FetchStatus}}{{end}}</td></tr>{{end}}</tbody>
          </table>
        </div>
      {{else}}
        <p class="empty-inline success-inline">{{t "repository.no_failed"}}</p>
      {{end}}
    </section>
    <section aria-labelledby="recent-snapshots">
      <div class="section-heading compact"><div><h2 id="recent-snapshots">{{t "repository.recent_snapshots"}}</h2><p>{{t "repository.recent_snapshots_help"}}</p></div></div>
      {{if .Repository.History}}
        <div class="table-scroll" role="region" aria-label="{{t "repository.recent_snapshots_region"}}" tabindex="0">
          <table class="data-table compact-table">
            <thead><tr><th scope="col">{{t "repository.date"}}</th><th scope="col" class="numeric">{{t "repositories.stars"}}</th><th scope="col" class="numeric">{{t "repository.oss_rank"}}</th><th scope="col">{{t "repository.outcome"}}</th></tr></thead>
            <tbody>{{range .Repository.History}}<tr><td>{{formatDate .Date}}</td><td class="numeric">{{formatIntPtr .Stars}}</td><td class="numeric">{{formatIntPtr .OSSRank}}</td><td><span class="status-badge {{statusClass .FetchStatus}}"><span aria-hidden="true"></span>{{statusLabel .FetchStatus}}</span></td></tr>{{end}}</tbody>
          </table>
        </div>
      {{else}}
        <p class="empty-inline">{{t "repository.no_snapshots"}}</p>
      {{end}}
    </section>
  </div>
{{end}}
