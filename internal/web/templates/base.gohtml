{{define "base"}}
<!doctype html>
<html lang="{{.Meta.Locale}}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{.Meta.Description}}">
  <meta name="color-scheme" content="light">
  <title>{{.Meta.Title}} · {{.Meta.SiteName}}</title>
  <link rel="stylesheet" href="/static/tokens.css">
  <link rel="stylesheet" href="/static/app.css">
  <link rel="stylesheet" href="/static/feed.css">
  <link rel="stylesheet" href="/static/imports.css">
  <link rel="stylesheet" href="/static/agent-access.css">
  <script defer src="/static/agent-access.js"></script>
  {{if or .Meta.Auth.Enabled (eq .Meta.ActiveNav "auth")}}<link rel="stylesheet" href="/static/auth.css">{{end}}
  {{if .Meta.Auth.Enabled}}<script defer src="/static/auth.js"></script>{{end}}
  <script defer src="/static/app.js"></script>
  <script defer src="/static/reading-position.js"></script>
</head>
<body data-active-nav="{{.Meta.ActiveNav}}"{{if .Meta.Auth.Enabled}} data-auth-enabled="true"{{end}}>
  {{$libraryIndex := ne .Repositories.Path ""}}
  <a class="skip-link" href="#main-content">{{t "nav.skip"}}</a>
  <aside class="app-sidebar" id="app-sidebar">
    <a class="brand" href="/?lang={{.Meta.Locale}}" aria-label="{{.Meta.SiteName}}">
      <span>{{.Meta.SiteName}}</span>
    </a>
    <nav class="primary-nav" aria-label="{{t "nav.primary"}}">
      <a class="nav-link {{if eq .Meta.ActiveNav "dashboard"}}is-active{{end}}" href="/?lang={{.Meta.Locale}}" {{if eq .Meta.ActiveNav "dashboard"}}aria-current="page"{{end}}>{{template "icon-chart"}}<span>{{t "nav.dashboard"}}</span></a>
      {{$inLibrary := or (eq .Meta.ActiveNav "repositories") (eq .Meta.ActiveNav "watch")}}
      <a class="nav-link {{if $inLibrary}}is-active{{end}}" href="{{libraryLocaleURL .LibraryReturnURL .Meta.Locale}}"{{if .LibraryReturnURL}} data-library-return{{end}} {{if $inLibrary}}aria-current="page"{{end}}>{{template "icon-grid"}}<span>{{t "nav.repositories"}}</span></a>
    </nav>
    <div class="sidebar-bottom">
      <div class="sidebar-account" data-account-root>
        {{if .Meta.Auth.Enabled}}
          {{if .Meta.Auth.SignedIn}}
          <button class="account-trigger" type="button" aria-expanded="false" aria-controls="account-menu" data-account-trigger>
            <span class="account-avatar" aria-hidden="true">{{template "icon-user"}}</span>
            <span class="account-copy"><strong translate="no">@{{.Meta.Auth.Login}}</strong><small>{{t "ui.github_account"}}</small></span>
            {{template "icon-chevron"}}
          </button>
          <div class="account-menu" id="account-menu" hidden data-account-menu>
            {{if .Meta.Auth.Admin}}<a href="/runs?lang={{.Meta.Locale}}">{{t "nav.history"}}</a>{{end}}
            <a href="/account/api?lang={{.Meta.Locale}}" data-agent-access>{{t "ui.api_access"}}</a>
            <form action="/auth/logout?lang={{.Meta.Locale}}" method="post"><input type="hidden" name="csrf_token" value="{{.Meta.Auth.CSRFToken}}"><button type="submit">{{authText "logout"}}</button></form>
          </div>
          {{else}}
          <a class="account-trigger" href="{{.Meta.Auth.LoginURL}}">
            <span class="account-avatar" aria-hidden="true">{{template "icon-user"}}</span>
            <span class="account-copy"><strong>{{authText "login"}}</strong><small>{{t "ui.github_oauth"}}</small></span>
            {{template "icon-chevron-right"}}
          </a>
          {{end}}
        {{else}}
          <button class="account-trigger" type="button" aria-expanded="false" aria-controls="account-menu" data-account-trigger>
            <span class="account-avatar" aria-hidden="true">{{template "icon-user"}}</span>
            <span class="account-copy"><strong>{{t "ui.local_workspace"}}</strong><small>{{t "ui.legacy_access"}}</small></span>
            {{template "icon-chevron"}}
          </button>
          <div class="account-menu" id="account-menu" hidden data-account-menu>
            <a href="/runs?lang={{.Meta.Locale}}">{{t "nav.history"}}</a>
            <span class="account-menu-disabled" aria-disabled="true" title="{{t "ui.api_unavailable_help"}}">{{t "ui.api_access"}} <small>{{t "ui.unavailable"}}</small></span>
          </div>
        {{end}}
      </div>
      <a class="sidebar-source" href="https://github.com/xz1220/repotempo" target="_blank" rel="noopener noreferrer"><span>Star on GitHub</span>{{template "icon-external"}}</a>
    </div>
  </aside>
  <div class="app-main">
    <header class="app-header">
      <div class="header-leading">
        <button class="sidebar-toggle" type="button" aria-label="{{t "ui.open_navigation"}}" aria-controls="app-sidebar" aria-expanded="false" data-sidebar-toggle>{{template "icon-menu"}}</button>
        <div class="header-context"><span>{{t "approved.workspace"}}</span><span class="header-slash">/</span><strong>{{if eq .Meta.ActiveNav "dashboard"}}{{t "nav.dashboard"}}{{else}}{{.Meta.Title}}{{end}}</strong></div>
      </div>
      <div class="header-right">
      {{if $libraryIndex}}
        <a class="button button-secondary header-export" href="{{libraryExportURL .ListURL}}">{{t "ui.export"}} <span aria-hidden="true">↓</span></a>
        <a class="button button-primary header-add" href="/watch/new?lang={{.Meta.Locale}}">{{template "icon-plus"}}{{t "approved.add_project"}}</a>
      {{end}}
      <nav class="language-switch" aria-label="{{t "language.label"}}">
        <a href="{{.Meta.ChineseURL}}" lang="zh-CN" {{if eq .Meta.Locale "zh-CN"}}aria-current="true"{{end}}>中文</a>
        <a href="{{.Meta.EnglishURL}}" lang="en" {{if eq .Meta.Locale "en"}}aria-current="true"{{end}}>EN</a>
      </nav>
      </div>
    </header>
    <main id="main-content" class="page-shell">
      {{if or $libraryIndex (eq .Meta.ActiveNav "dashboard")}}<h1 class="sr-only">{{.Meta.Title}}</h1><p class="sr-only">{{tf "ui.data_date" .Meta.AsOfLabel}}</p>{{else}}
      <header class="page-heading">
        <div class="page-heading-copy">
          {{block "page-meta" .}}{{end}}
          <h1 class="{{if eq .Meta.TitleKind "repository"}}entity-title-repository{{end}}" {{if .Meta.TitleKind}}translate="no"{{end}}>{{.Meta.Title}}</h1>
          <p>{{.Meta.Description}}</p>
        </div>
        <div class="page-heading-tools">
          {{if and (ne .Meta.ActiveNav "watch") (ne .Meta.ActiveNav "auth")}}<span class="as-of">{{tf "ui.data_date" .Meta.AsOfLabel}}</span>{{end}}
        </div>
      </header>
      {{end}}
      {{if .Meta.Stale}}<div class="notice notice-warning" role="status">{{template "icon-history"}}<p>{{tf "ui.stale_notice" .Meta.AsOfLabel}} <a href="/runs?lang={{.Meta.Locale}}">{{t "ui.inspect_collection"}}</a></p></div>{{end}}
      {{range .Meta.Warnings}}<div class="notice notice-warning" role="status"><p>{{.}}</p></div>{{end}}
      {{template "content" .}}
    </main>
    <footer class="app-footer"><p>{{t "page.footer"}}</p><span>{{.Meta.SiteName}} · MIT</span></footer>
  </div>
</body>
</html>
{{end}}

{{define "icon-radar"}}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="1.5"/><path d="M12 12 19 5M12 3v3M3 12h3M12 18v3M18 12h3" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="1.5" fill="currentColor"/></svg>{{end}}
{{define "icon-chart"}}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 4v16h16M7 15l4-5 4 2 5-7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>{{end}}
{{define "icon-compass"}}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.7"/><path d="m16 8-2.5 5.5L8 16l2.5-5.5L16 8Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>{{end}}
{{define "icon-grid"}}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="4" y="4" width="6" height="6" rx="1" stroke="currentColor" stroke-width="1.7"/><rect x="14" y="4" width="6" height="6" rx="1" stroke="currentColor" stroke-width="1.7"/><rect x="4" y="14" width="6" height="6" rx="1" stroke="currentColor" stroke-width="1.7"/><rect x="14" y="14" width="6" height="6" rx="1" stroke="currentColor" stroke-width="1.7"/></svg>{{end}}
{{define "icon-layers"}}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m3 8 9-5 9 5-9 5-9-5Zm0 4 9 5 9-5M3 16l9 5 9-5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>{{end}}
{{define "icon-bookmark"}}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 4h12v17l-6-4-6 4V4Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>{{end}}
{{define "icon-plus"}}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>{{end}}
{{define "icon-history"}}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 10a9 9 0 1 1 1 7M3 4v6h6m3-3v6l4 2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>{{end}}
{{define "icon-arrow"}}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>{{end}}
{{define "icon-search"}}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.7"/><path d="m16 16 5 5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>{{end}}
{{define "icon-user"}}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="8" r="3.5" stroke="currentColor" stroke-width="1.7"/><path d="M5 21v-2a7 7 0 0 1 14 0v2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>{{end}}
{{define "icon-chevron"}}<svg class="account-chevron" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m8 9 4-4 4 4m-8 6 4 4 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>{{end}}
{{define "icon-chevron-right"}}<svg class="account-chevron" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m9 6 6 6-6 6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>{{end}}
{{define "icon-external"}}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>{{end}}
{{define "icon-download"}}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 4v11m-4-4 4 4 4-4M5 20h14" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>{{end}}
{{define "icon-menu"}}<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>{{end}}
{{define "chart"}}
  <section class="chart-panel" aria-labelledby="{{.ID}}">
    <div class="section-heading compact">
      <div>
        <h2 id="{{.ID}}">{{.Title}}</h2>
        <p>{{.Description}}</p>
      </div>
    </div>
    {{if .HasData}}
      <div class="chart-frame">
        <svg class="line-chart" viewBox="0 0 800 224" role="img" aria-label="{{.Description}}" preserveAspectRatio="none">
          <line class="chart-grid" x1="16" y1="14" x2="784" y2="14"></line>
          <line class="chart-grid" x1="16" y1="106" x2="784" y2="106"></line>
          <line class="chart-grid" x1="16" y1="198" x2="784" y2="198"></line>
          {{range .Segments}}
            <polyline class="chart-line" points="{{.Points}}"></polyline>
          {{end}}
          {{range .Points}}
            <circle class="chart-dot" cx="{{.X}}" cy="{{.Y}}" r="3">
              <title>{{.Label}}: {{.Value}}</title>
            </circle>
          {{end}}
        </svg>
        <div class="chart-y-label chart-y-top">{{.MaxLabel}}</div>
        <div class="chart-y-label chart-y-bottom">{{.MinLabel}}</div>
        <div class="chart-x-label chart-x-start">{{.StartLabel}}</div>
        <div class="chart-x-label chart-x-end">{{.EndLabel}}</div>
      </div>
    {{else}}
      <div class="empty-state compact-empty">
        <h3>{{t "chart.no_points"}}</h3>
        <p>{{t "chart.no_points_help"}}</p>
      </div>
    {{end}}
    {{if .Observations}}
      <details class="chart-details">
        <summary>{{t "chart.exact_values"}}</summary>
        <div class="table-scroll" role="region" aria-label="{{t "chart.exact_values_region"}}" tabindex="0">
          <table class="data-table compact-table">
            <thead><tr><th scope="col">{{t "chart.observation"}}</th><th scope="col" class="numeric">{{t "chart.value"}}</th></tr></thead>
            <tbody>{{range .Observations}}<tr><td class="mono-value">{{.Label}}</td><td class="numeric">{{if .Missing}}<span class="muted">{{t "chart.missing"}}</span>{{else}}{{.Value}}{{end}}</td></tr>{{end}}</tbody>
          </table>
        </div>
      </details>
    {{end}}
  </section>
{{end}}
