{{define "base"}}
<!doctype html>
<html lang="{{.Meta.Locale}}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="{{.Meta.Description}}">
  <meta name="color-scheme" content="light">
  <title>{{.Meta.Title}} · {{.Meta.SiteName}}</title>
  <link rel="stylesheet" href="/static/tokens.css">
  <link rel="stylesheet" href="/static/app.css">
  <script defer src="/static/app.js"></script>
</head>
<body>
  <a class="skip-link" href="#main-content">{{t "nav.skip"}}</a>
  <header class="app-header">
    <div class="header-inner">
      <a class="brand" href="/" aria-label="{{tf "nav.brand_projects" .Meta.SiteName}}">
        <span class="brand-mark" aria-hidden="true">GR</span>
        <span>{{.Meta.SiteName}}</span>
      </a>
      <nav id="primary-navigation" class="primary-nav" aria-label="{{t "nav.primary"}}">
        <a class="nav-link {{if eq .Meta.ActiveNav "repositories"}}is-active{{end}}" href="/" {{if eq .Meta.ActiveNav "repositories"}}aria-current="page"{{end}}>{{t "nav.repositories"}}</a>
        <a class="nav-link {{if eq .Meta.ActiveNav "topics"}}is-active{{end}}" href="/topics" {{if eq .Meta.ActiveNav "topics"}}aria-current="page"{{end}}>{{t "nav.topics"}}</a>
      </nav>
      <div class="header-utilities">
        <a class="history-link {{if eq .Meta.ActiveNav "runs"}}is-active{{end}}" href="/runs" {{if eq .Meta.ActiveNav "runs"}}aria-current="page"{{end}}>{{t "nav.history"}}</a>
        <nav class="language-switch" aria-label="{{t "language.label"}}">
          <a href="{{.Meta.ChineseURL}}" lang="zh-CN" {{if eq .Meta.Locale "zh-CN"}}aria-current="true"{{end}}>{{t "language.chinese"}}</a>
          <a href="{{.Meta.EnglishURL}}" lang="en" {{if eq .Meta.Locale "en"}}aria-current="true"{{end}}>{{t "language.english"}}</a>
        </nav>
      </div>
    </div>
  </header>

  <main id="main-content" class="page-shell">
    <header class="page-heading">
      <div class="page-heading-copy">
        {{block "page-meta" .}}{{end}}
        <h1 class="{{if eq .Meta.TitleKind "repository"}}entity-title-repository{{else if eq .Meta.TitleKind "topic"}}entity-title-topic{{end}}" {{if .Meta.TitleKind}}translate="no"{{end}}>{{.Meta.Title}}</h1>
        <p>{{.Meta.Description}}</p>
      </div>
      <p class="as-of">{{tf "page.as_of" .Meta.AsOfLabel}}</p>
    </header>

    {{range .Meta.Warnings}}
      <div class="notice notice-warning" role="status">
        <span class="notice-symbol" aria-hidden="true">!</span>
        <p>{{.}}</p>
      </div>
    {{end}}

    {{template "content" .}}
  </main>

  <footer class="app-footer">
    <div>
      <strong>{{.Meta.SiteName}}</strong>
      <p>{{t "page.footer"}}</p>
    </div>
    <p class="footer-links"><a href="https://github.com/xz1220/github-radar" target="_blank" rel="noopener noreferrer">GitHub</a><span>MIT</span></p>
  </footer>
</body>
</html>
{{end}}

{{define "chart"}}
  <section class="chart-panel" aria-labelledby="{{.ID}}">
    <div class="section-heading compact">
      <div>
        <h2 id="{{.ID}}">{{.Title}}</h2>
        <p>{{.Description}}</p>
      </div>
    </div>
    {{if .HasData}}
      <div class="chart-frame">
        <svg class="line-chart" viewBox="0 0 800 224" role="img" aria-label="{{.Description}}" preserveAspectRatio="none">
          <line class="chart-grid" x1="16" y1="14" x2="784" y2="14"></line>
          <line class="chart-grid" x1="16" y1="106" x2="784" y2="106"></line>
          <line class="chart-grid" x1="16" y1="198" x2="784" y2="198"></line>
          {{range .Segments}}
            <polyline class="chart-line" points="{{.Points}}"></polyline>
          {{end}}
          {{range .Points}}
            <circle class="chart-dot" cx="{{.X}}" cy="{{.Y}}" r="3">
              <title>{{.Label}}: {{.Value}}</title>
            </circle>
          {{end}}
        </svg>
        <div class="chart-y-label chart-y-top">{{.MaxLabel}}</div>
        <div class="chart-y-label chart-y-bottom">{{.MinLabel}}</div>
        <div class="chart-x-label chart-x-start">{{.StartLabel}}</div>
        <div class="chart-x-label chart-x-end">{{.EndLabel}}</div>
      </div>
    {{else}}
      <div class="empty-state compact-empty">
        <h3>{{t "chart.no_points"}}</h3>
        <p>{{t "chart.no_points_help"}}</p>
      </div>
    {{end}}
    {{if .Observations}}
      <details class="chart-details">
        <summary>{{t "chart.exact_values"}}</summary>
        <div class="table-scroll" role="region" aria-label="{{t "chart.exact_values_region"}}" tabindex="0">
          <table class="data-table compact-table">
            <thead><tr><th scope="col">{{t "chart.observation"}}</th><th scope="col" class="numeric">{{t "chart.value"}}</th></tr></thead>
            <tbody>{{range .Observations}}<tr><td class="mono-value">{{.Label}}</td><td class="numeric">{{if .Missing}}<span class="muted">{{t "chart.missing"}}</span>{{else}}{{.Value}}{{end}}</td></tr>{{end}}</tbody>
          </table>
        </div>
      </details>
    {{end}}
  </section>
{{end}}
