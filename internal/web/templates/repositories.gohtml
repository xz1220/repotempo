{{define "content"}}
<div class="library-toolbar">
  <nav class="library-views" aria-label="{{t "ui.all_library"}}">
    {{range .LibraryViews}}<a href="{{.URL}}" class="{{if .Active}}is-active{{end}}" {{if .Active}}aria-current="page"{{end}}>{{.Label}}</a>{{end}}
  </nav>
  <a class="button button-secondary library-add" href="/watch/new">{{template "icon-plus"}}{{t "ui.add_project"}}</a>
</div>
<nav class="category-tabs" aria-label="{{t "ui.category_filter"}}">{{range .Categories}}<a href="{{.URL}}" class="category-tab {{if .Active}}is-active{{end}}" {{if .Active}}aria-current="page"{{end}}>{{t .Label}}</a>{{end}}</nav>
<section class="surface library-surface" aria-label="{{t "repositories.metrics_region"}}">
  <form class="library-filters" method="get" action="/repositories" role="search">
    <input type="hidden" name="lang" value="{{.Meta.Locale}}">
    {{if .Repositories.Filter.OnlyFocus}}<input type="hidden" name="focus" value="1">{{end}}
    <div class="field field-search"><label for="repository-search">{{t "repositories.search"}}</label><input id="repository-search" name="q" type="search" value="{{.Repositories.Filter.Search}}" placeholder="{{t "ui.search_hint"}}" autocomplete="off"></div>
    <div class="field"><label for="topic-filter">{{t "repositories.topic"}}</label><select name="topic" id="topic-filter"><option value="">{{t "repositories.all_topics"}}</option><option value="__unclassified" {{if eq .Repositories.Filter.TopicSlug "__unclassified"}}selected{{end}}>{{t "category.__unclassified"}}</option>{{range .Repositories.Topics}}<option value="{{.Slug}}" {{if eq $.Repositories.Filter.TopicSlug .Slug}}selected{{end}}>{{if .ParentName}}↳ {{end}}{{topicName .Slug .Name}}</option>{{end}}</select></div>
    <div class="field"><label for="source-filter">{{t "repositories.discovery_source"}}</label><select name="source" id="source-filter"><option value="">{{t "repositories.all_sources"}}</option>{{range .Repositories.Sources}}<option value="{{.}}" {{if eq $.Repositories.Filter.Source .}}selected{{end}}>{{sourceLabel .}}</option>{{end}}</select></div>
    <div class="field"><label for="sort-filter">{{t "repositories.sort_label"}}</label><select id="sort-filter" name="sort">
      <option value="velocity" {{if eq .Repositories.Filter.Sort "velocity"}}selected{{end}}>{{t "ui.fastest"}}</option>
      <option value="delta" {{if eq .Repositories.Filter.Sort "delta"}}selected{{end}}>{{t "ui.period_gain"}}</option>
      <option value="growth_rate" {{if eq .Repositories.Filter.Sort "growth_rate"}}selected{{end}}>{{t "repositories.sort_growth_rate"}}</option>
      <option value="low_growth" {{if eq .Repositories.Filter.Sort "low_growth"}}selected{{end}}>{{t "ui.slowest"}}</option>
      <option value="slowdown" {{if eq .Repositories.Filter.Sort "slowdown"}}selected{{end}}>{{t "ui.slowdown"}}</option>
      <option value="stars" {{if eq .Repositories.Filter.Sort "stars"}}selected{{end}}>{{t "repositories.sort_stars"}}</option>
      <option value="rank_change" {{if eq .Repositories.Filter.Sort "rank_change"}}selected{{end}}>{{t "repositories.sort_rank_change"}}</option>
      <option value="newest" {{if eq .Repositories.Filter.Sort "newest"}}selected{{end}}>{{t "repositories.sort_newest"}}</option>
    </select></div>
    <div class="field"><label for="period-filter">{{t "repositories.period_label"}}</label><select id="period-filter" name="period"><option value="1d" {{if eq .Repositories.Filter.WindowDays 1}}selected{{end}}>{{t "period.1d"}}</option><option value="7d" {{if eq .Repositories.Filter.WindowDays 7}}selected{{end}}>{{t "period.7d"}}</option><option value="30d" {{if eq .Repositories.Filter.WindowDays 30}}selected{{end}}>{{t "period.30d"}}</option></select></div>
    <div class="field"><label for="as-of-date">{{t "repositories.as_of_date"}}</label><input id="as-of-date" name="date" type="date" value="{{formatDate .Repositories.Filter.AsOf}}"></div>
    <div class="filter-actions"><label class="new-project-filter"><input type="checkbox" name="new" value="1" {{if .Repositories.Filter.OnlyNew}}checked{{end}}>{{t "ui.only_new_on_date"}}</label><button class="button button-primary" type="submit">{{t "ui.filter"}}</button></div>
  </form>
  {{if .Repositories.Filter.OnlyNew}}<p class="new-project-note">{{t "ui.new_filter_help"}}</p>{{end}}
  <div class="library-count"><p>{{tf "repositories.count" (formatInt .Repositories.Total)}}</p><span>{{formatDate .Repositories.Coverage.BaselineDate}} → {{formatDate .Repositories.Coverage.AsOfDate}}</span></div>
</section>
{{if .Repositories.Items}}
<ol class="repository-feed" aria-label="{{t "feed.list_label"}}">
  {{range .Repositories.Items}}
  <li>
    <article class="project-card" aria-labelledby="project-{{.ID}}">
      <header class="project-card-heading">
        <div class="project-card-identity">
          <h2 id="project-{{.ID}}"><a href="/repositories/{{.ID}}?date={{formatDate $.Repositories.Filter.AsOf}}&amp;lang={{$.Meta.Locale}}" translate="no">{{.FullName}}</a></h2>
          <div class="project-card-badges">{{if .IsNew}}<span class="new-badge">{{t "repositories.new_badge"}}</span>{{end}}{{if .IsFocus}}<span class="new-badge">{{t "ui.my_watchlist"}}</span>{{end}}{{if ne .MonitoringStatus "active"}}{{if .MonitoringStatus}}<span class="tag tag-muted">{{statusLabel .MonitoringStatus}}</span>{{end}}{{end}}{{if ne .GitHubStatus "active"}}{{if .GitHubStatus}}<span class="tag tag-muted">{{statusLabel .GitHubStatus}}</span>{{end}}{{end}}</div>
        </div>
        {{if .PrimaryLanguage}}<span class="project-language" translate="no">{{.PrimaryLanguage}}</span>{{end}}
      </header>

      <div class="project-card-body">
        <div class="project-card-reading">
          <p class="project-original-description">{{if .Description}}{{.Description}}{{else}}{{t "ui.no_description"}}{{end}}</p>
          <section class="project-brief" aria-label="{{t "feed.brief"}}">
            {{if and .Analysis (briefText .Analysis.SummaryZH)}}
              <div class="project-brief-heading"><h3>{{if aiAnalysis .Analysis.Source}}{{t "feed.ai_brief"}}{{else}}{{t "feed.saved_brief"}}{{end}}</h3><span>{{formatDate .Analysis.AnalyzedAt}}</span></div>
              <p class="project-brief-text" lang="zh-CN">{{briefText .Analysis.SummaryZH}}</p>
              <p class="project-brief-source">{{tf "feed.reading_source" (analysisSource .Analysis.Source)}}{{if .Analysis.Model}} · <span translate="no">{{.Analysis.Model}}</span>{{end}}</p>
            {{else}}
              <div class="project-brief-heading"><h3>{{t "feed.ai_brief"}}</h3><span>{{t "feed.not_read"}}</span></div>
              <p class="project-brief-pending">{{t "feed.pending_help"}}</p>
            {{end}}
          </section>
        </div>

        <dl class="project-card-metrics" aria-label="{{t "repositories.metrics_region"}}">
          <div><dt>{{t "metric.current_stars"}}</dt><dd>{{if .CurrentStars}}{{formatIntPtr .CurrentStars}}{{else}}{{formatIntPtr .LastObservedStars}}{{end}}{{if not .CurrentStars}}<small class="metric-pending">{{t "ui.pending"}}</small>{{end}}</dd></div>
          <div><dt>{{t "ui.period_gain"}}</dt><dd class="{{deltaClass .StarDelta}}">{{formatSigned .StarDelta}}{{if eq $.Repositories.Filter.Sort "slowdown"}}<small>{{tf "feed.previous_gain" (formatSigned .PreviousDelta)}}</small>{{end}}</dd></div>
          <div><dt>{{t "repositories.growth_rate"}}</dt><dd class="{{floatDeltaClass .GrowthRate}}">{{formatPercent .GrowthRate}}</dd></div>
          <div><dt>{{t "feed.sample_rank"}}</dt><dd>{{if .CurrentRank}}<span class="project-card-rank"><span>{{formatIntPtr .BaselineRank}}</span><span aria-hidden="true">→</span><strong>{{formatIntPtr .CurrentRank}}</strong></span>{{else}}{{t "page.not_available"}}{{end}}{{if .RankChange}}<small class="{{deltaClass .RankChange}}">{{tf "repositories.rank_change" (formatSigned .RankChange)}}</small>{{end}}</dd></div>
          {{if not .StarDelta}}<div class="project-comparison-note"><dt class="sr-only">{{t "feed.comparison_status"}}</dt><dd>{{t "feed.no_comparison"}}</dd></div>{{end}}
        </dl>
      </div>

      <div class="project-card-topics">{{range .Topics}}<span class="tag">{{topicName .Slug .Name}}</span>{{else}}<span class="tag tag-muted">{{t "category.__unclassified"}}</span>{{end}}</div>
      <footer class="project-card-footer">
        <div class="project-card-meta">
          <span>{{t "feed.added"}} <time datetime="{{formatDate .FirstSeenAt}}">{{formatDate .FirstSeenAt}}</time></span>
          {{if .GitHubCreatedAt}}<span>{{t "feed.created"}} {{formatDatePtr .GitHubCreatedAt}}</span>{{end}}
          <span>{{t "feed.origin"}} {{sourceLabel .FirstSeenSource}}</span>
          {{if .IsStale}}{{if .LastObservedAt}}<span class="metric-pending">{{tf "ui.last_observed" (formatDatePtr .LastObservedAt)}}</span>{{end}}{{end}}
        </div>
        <div class="project-card-actions">
          <a class="button button-secondary" href="/repositories/{{.ID}}?date={{formatDate $.Repositories.Filter.AsOf}}&amp;lang={{$.Meta.Locale}}">{{t "feed.details"}}</a>
          {{with projectGitHubURL .FullName .HTMLURL}}<a class="button button-secondary project-github-link" href="{{.}}" target="_blank" rel="noopener noreferrer">{{t "repository.open_github"}} <span aria-hidden="true">↗</span></a>{{end}}
        </div>
      </footer>
    </article>
  </li>
  {{end}}
</ol>
{{else}}<div class="empty-state"><h3>{{t "repositories.no_match"}}</h3><p>{{t "repositories.no_match_help"}}</p><a class="button button-secondary" href="/repositories">{{t "repositories.clear_filters"}}</a></div>{{end}}
<nav class="cursor-pagination" aria-label="{{t "pagination.label"}}"><p>{{tf "repositories.page_summary" (formatInt (len .Repositories.Items)) (formatInt .Repositories.Total)}}</p><div>{{if .Repositories.Filter.AfterID}}<a class="button button-secondary" href="{{.Repositories.FirstPageURL}}">{{t "ui.first_page"}}</a>{{end}}{{if .Repositories.NextCursor}}<a class="button button-secondary" href="{{.Repositories.NextCursor}}" rel="next">{{t "pagination.next"}} {{template "icon-arrow"}}</a>{{end}}</div></nav>
<details class="method-note"><summary>{{t "ui.methodology"}}</summary><p>{{t "ui.methodology_help"}} <a class="text-link" href="/topics">{{t "ui.category_rules"}}</a></p></details>
{{end}}
