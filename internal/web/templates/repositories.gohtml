{{define "content"}}
<div class="library-toolbar">
  <nav class="library-views" aria-label="{{t "daily.views"}}">
    {{range .LibraryViews}}<a href="{{.URL}}" class="{{if .Active}}is-active{{end}}" {{if .Active}}aria-current="page"{{end}}>{{.Label}}</a>{{end}}
  </nav>
  <a class="button button-secondary library-add" href="/watch/new">{{template "icon-plus"}}{{t "library.import"}}</a>
</div>
<section class="surface library-surface" aria-label="{{t "repositories.metrics_region"}}">
  <form class="library-filters" method="get" action="/repositories" role="search">
    <input type="hidden" name="lang" value="{{.Meta.Locale}}">
    <input type="hidden" name="view" value="{{if .Repositories.Filter.OnlyFocus}}focus{{else}}all{{end}}">
    {{if .Repositories.Filter.TopicSlug}}<input type="hidden" name="topic" value="{{.Repositories.Filter.TopicSlug}}">{{end}}
    {{if .Repositories.Filter.Source}}<input type="hidden" name="source" value="{{.Repositories.Filter.Source}}">{{end}}
    {{if .Repositories.Filter.OnlyFocus}}<input type="hidden" name="focus" value="1">{{end}}
    <div class="field field-search"><label for="repository-search">{{t "repositories.search"}}</label><input id="repository-search" name="q" type="search" value="{{.Repositories.Filter.Search}}" placeholder="{{t "ui.search_hint"}}" autocomplete="off"></div>
    <div class="field field-tags"><label for="tag-filter">{{t "tags.filter"}}</label><input type="search" name="tag" id="tag-filter" list="repository-tags" value="{{.Repositories.Filter.Tag}}" placeholder="{{t "tags.placeholder"}}" maxlength="80" autocomplete="off" aria-describedby="tag-filter-help"><datalist id="repository-tags">{{range .Repositories.Tags}}<option value="{{.Name}}">{{tagOptionLabel .Name}}</option>{{end}}</datalist></div>
    <div class="field"><label for="sort-filter">{{t "repositories.sort_label"}}</label><select id="sort-filter" name="sort">
      <option value="velocity" {{if eq .Repositories.Filter.Sort "velocity"}}selected{{end}}>{{t "ui.fastest"}}</option>
      <option value="delta" {{if eq .Repositories.Filter.Sort "delta"}}selected{{end}}>{{t "ui.period_gain"}}</option>
      <option value="growth_rate" {{if eq .Repositories.Filter.Sort "growth_rate"}}selected{{end}}>{{t "repositories.sort_growth_rate"}}</option>
      <option value="low_growth" {{if eq .Repositories.Filter.Sort "low_growth"}}selected{{end}}>{{t "ui.slowest"}}</option>
      <option value="slowdown" {{if eq .Repositories.Filter.Sort "slowdown"}}selected{{end}}>{{t "ui.slowdown"}}</option>
      <option value="stars" {{if eq .Repositories.Filter.Sort "stars"}}selected{{end}}>{{t "repositories.sort_stars"}}</option>
      <option value="rank_change" {{if eq .Repositories.Filter.Sort "rank_change"}}selected{{end}}>{{t "repositories.sort_rank_change"}}</option>
      <option value="newest" {{if eq .Repositories.Filter.Sort "newest"}}selected{{end}}>{{t "repositories.sort_newest"}}</option>
    </select></div>
    <div class="field"><label for="period-filter">{{t "tags.period"}}</label><select id="period-filter" name="period" aria-describedby="growth-period-help"><option value="1d" {{if eq .Repositories.Filter.WindowDays 1}}selected{{end}}>{{t "tags.1d"}}</option><option value="7d" {{if eq .Repositories.Filter.WindowDays 7}}selected{{end}}>{{t "tags.7d"}}</option><option value="30d" {{if eq .Repositories.Filter.WindowDays 30}}selected{{end}}>{{t "tags.30d"}}</option></select></div>
    <div class="field"><label for="as-of-date">{{t "repositories.as_of_date"}}</label><input id="as-of-date" name="date" type="date" value="{{formatDate .Repositories.Filter.AsOf}}"></div>
    <div class="filter-actions"><label class="new-project-filter"><input type="checkbox" name="new" value="1" {{if .Repositories.Filter.OnlyNew}}checked{{end}}>{{t "ui.only_new_on_date"}}</label><input type="hidden" name="new" value="0"><button class="button button-primary" type="submit">{{t "ui.filter"}}</button></div>
  </form>
  {{if .SuggestedTags}}<nav class="library-quick-tags" aria-label="{{t "tags.quick"}}"><span>{{t "tags.quick"}}</span>{{range .SuggestedTags}}<a class="tag {{if .Active}}tag-selected{{end}}" href="{{.URL}}">{{.Label}}</a>{{end}}</nav>{{end}}
  <div class="library-filter-help"><p id="tag-filter-help">{{t "tags.help"}}</p><p id="growth-period-help">{{t "tags.period_help"}}</p></div>
  {{if .ActiveFilters}}<div class="library-active-filters">{{range .ActiveFilters}}<a class="tag" href="{{.URL}}">{{.Label}} <span aria-hidden="true">×</span><span class="sr-only">{{t "tags.clear"}}</span></a>{{end}}</div>{{end}}
  {{if .Repositories.Filter.OnlyNew}}<p class="new-project-note">{{t "ui.new_filter_help"}}</p>{{end}}
  <div class="library-count"><p>{{tf "repositories.count" (formatInt .Repositories.Total)}}</p><span>{{tf "tags.comparison" (formatDate .Repositories.Coverage.BaselineDate) (formatDate .Repositories.Coverage.AsOfDate)}}</span></div>
</section>
{{if .Repositories.Items}}
<p id="reading-local-note" class="reading-local-note" data-reading-help hidden>{{t "feed.reading_local_note"}}</p>
<ol class="repository-feed" aria-label="{{t "feed.list_label"}}" data-list-url="{{.ListURL}}">
  {{range .Repositories.Items}}
  <li>
    <article class="project-card" aria-labelledby="project-{{.ID}}" data-reading-repository="{{.ID}}">
      <header class="project-card-heading">
        <div class="project-card-identity">
          <h2 id="project-{{.ID}}"><a href="{{index $.RepositoryDetailURLs .ID}}" data-repository-detail translate="no">{{.FullName}}</a></h2>
          <div class="project-card-badges">{{if .IsNew}}<span class="new-badge">{{t "repositories.new_badge"}}</span>{{end}}{{if .IsFocus}}<span class="new-badge">{{t "ui.my_watchlist"}}</span>{{end}}{{if ne .MonitoringStatus "active"}}{{if .MonitoringStatus}}<span class="tag tag-muted">{{statusLabel .MonitoringStatus}}</span>{{end}}{{end}}{{if ne .GitHubStatus "active"}}{{if .GitHubStatus}}<span class="tag tag-muted">{{statusLabel .GitHubStatus}}</span>{{end}}{{end}}</div>
        </div>
        {{if .PrimaryLanguage}}<span class="project-language" translate="no">{{.PrimaryLanguage}}</span>{{end}}
      </header>

      <div class="project-card-body">
        <div class="project-card-reading">
          <p class="project-original-description">{{if .Description}}{{.Description}}{{else}}{{t "ui.no_description"}}{{end}}</p>
          <section class="project-brief" aria-label="{{t "feed.brief"}}">
            {{if and .Analysis (briefText .Analysis.SummaryZH)}}
              <div class="project-brief-heading"><h3>{{if aiAnalysis .Analysis.Source}}{{t "feed.ai_brief"}}{{else}}{{t "feed.saved_brief"}}{{end}}</h3><span>{{if eq .Analysis.Source "legacy_research"}}{{t "feed.legacy_date"}}{{else}}{{formatDate .Analysis.AnalyzedAt}}{{end}}</span></div>
              <dl class="project-brief-outline">
                <div><dt>{{t "activity.purpose"}}</dt><dd><p class="project-brief-text" lang="zh-CN">{{briefText .Analysis.SummaryZH}}</p></dd></div>
                {{with briefItems .Analysis.KeyPoints}}<div class="brief-secondary"><dt>{{t "activity.capabilities"}}</dt><dd lang="zh-CN">{{join . " · "}}</dd></div>{{end}}
                {{with briefItems .Analysis.UseCases}}<div class="brief-secondary"><dt>{{t "activity.use_cases"}}</dt><dd lang="zh-CN">{{join . " · "}}</dd></div>{{end}}
              </dl>
              <p class="project-brief-source">{{if eq .Analysis.Source "legacy_research"}}{{tf "feed.reading_source" (t "feed.legacy_source")}}{{else}}{{tf "feed.reading_source" (analysisSource .Analysis.Source)}}{{end}}{{if .Analysis.Model}} · <span translate="no">{{.Analysis.Model}}</span>{{end}}</p>
            {{else if .Readme}}
              <div class="project-brief-heading"><h3>{{importText "readme"}}</h3><span>{{formatDate .Readme.FetchedAt}}</span></div>
              <p class="project-brief-text" translate="no">{{.Readme.Intro}}</p>
              <p class="readme-source">{{importText "readme_help"}} {{with githubURL .Readme.HTMLURL}}<a class="text-link" href="{{.}}" target="_blank" rel="noopener noreferrer">{{importText "readme_open"}} ↗</a>{{end}}</p>
            {{else}}
              <div class="project-brief-heading"><h3>{{t "feed.ai_brief"}}</h3><span>{{t "feed.not_read"}}</span></div>
              <p class="project-brief-pending">{{t "feed.pending_help"}}</p>
            {{end}}
          </section>
          {{with activityView . $.Repositories.Filter.AsOf}}
          <div class="project-development">
            {{if .HasCache}}
            <p class="activity-heading" title="{{.PeriodLabel}}">{{.Heading}} · {{t "activity.card_window"}}</p>
            <p class="activity-summary"><strong>{{.Summary}}</strong>{{if .Incomplete}} <span class="activity-partial" title="{{t "activity.incomplete"}}">{{t "activity.partial"}}</span>{{end}} <span class="activity-source">{{t "activity.source"}}{{if .Branch}} · <span translate="no">{{.Branch}}</span>{{end}}</span></p>
            {{if .IsFork}}<p class="activity-note">{{t "activity.fork"}}</p>{{end}}
            {{else}}{{if .CommitsURL}}<a class="text-link activity-source" href="{{.CommitsURL}}" target="_blank" rel="noopener noreferrer">{{t "activity.view_commits"}} ↗</a>{{end}}{{end}}
          </div>
          {{end}}
        </div>

        <dl class="project-card-metrics" aria-label="{{t "repositories.metrics_region"}}">
          <div><dt>{{t "metric.current_stars"}}</dt><dd>{{if .CurrentStars}}{{formatIntPtr .CurrentStars}}{{else}}{{formatIntPtr .LastObservedStars}}{{end}}{{if not .CurrentStars}}<small class="metric-pending">{{t "ui.pending"}}</small>{{end}}</dd></div>
          <div><dt>{{t "ui.period_gain"}}</dt><dd class="{{deltaClass .StarDelta}}">{{formatSigned .StarDelta}}{{if eq $.Repositories.Filter.Sort "slowdown"}}<small>{{tf "feed.previous_gain" (formatSigned .PreviousDelta)}}</small>{{end}}</dd></div>
          <div><dt>{{t "repositories.growth_rate"}}</dt><dd class="{{floatDeltaClass .GrowthRate}}">{{formatPercent .GrowthRate}}</dd></div>
          <div><dt>{{t "feed.sample_rank"}}</dt><dd>{{if .CurrentRank}}<span class="project-card-rank"><span>{{formatIntPtr .BaselineRank}}</span><span aria-hidden="true">→</span><strong>{{formatIntPtr .CurrentRank}}</strong></span>{{else}}{{t "page.not_available"}}{{end}}{{if .RankChange}}<small class="{{deltaClass .RankChange}}">{{tf "repositories.rank_change" (formatSigned .RankChange)}}</small>{{end}}</dd></div>
          {{if not .StarDelta}}<div class="project-comparison-note"><dt class="sr-only">{{t "feed.comparison_status"}}</dt><dd>{{t "feed.no_comparison"}}</dd></div>{{end}}
        </dl>
      </div>

      <div class="project-card-topics">{{with index $.RepositoryTags .ID}}{{range .Visible}}<a class="tag {{if .Active}}tag-selected{{end}}" href="{{.URL}}">{{.Label}}</a>{{else}}<span class="tag tag-muted">{{t "tags.none"}}</span>{{end}}{{if .More}}<details class="project-more-tags"><summary>{{tf "tags.more" (len .More)}}</summary><div>{{range .More}}<a class="tag {{if .Active}}tag-selected{{end}}" href="{{.URL}}">{{.Label}}</a>{{end}}</div></details>{{end}}{{end}}</div>
      <footer class="project-card-footer">
        <div class="project-card-meta">
          <span>{{t "feed.added"}} <time datetime="{{formatDate .FirstSeenAt}}">{{formatDate .FirstSeenAt}}</time></span>
          {{if .GitHubCreatedAt}}<span>{{t "feed.created"}} {{formatDatePtr .GitHubCreatedAt}}</span>{{end}}
          {{with repositoryAge .GitHubCreatedAt $.Repositories.Filter.AsOf}}<span class="repository-age" title="{{.Help}}">{{t "activity.age"}} {{.Label}}</span>{{end}}
          <span>{{t "feed.origin"}} {{sourceLabel .FirstSeenSource}}</span>
          {{if .IsStale}}{{if .LastObservedAt}}<span class="metric-pending">{{tf "ui.last_observed" (formatDatePtr .LastObservedAt)}}</span>{{end}}{{end}}
        </div>
        <div class="project-card-actions">
          <button type="button" class="button button-secondary project-read-toggle" data-reading-toggle data-reading-mark-read="{{t "feed.mark_read"}}" data-reading-mark-unread="{{t "feed.mark_unread"}}" data-reading-load-error="{{t "feed.reading_load_error"}}" data-reading-save-error="{{t "feed.reading_save_error"}}" aria-pressed="false" aria-describedby="reading-local-note reading-note-{{.ID}}" hidden>{{t "feed.mark_read"}}</button>
          <a class="button button-secondary" href="{{index $.RepositoryDetailURLs .ID}}" data-repository-detail>{{t "feed.details"}}</a>
          {{with projectGitHubURL .FullName .HTMLURL}}<a class="button button-secondary project-github-link" href="{{.}}" target="_blank" rel="noopener noreferrer">{{t "repository.open_github"}} <span aria-hidden="true">↗</span></a>{{end}}
        </div>
      </footer>
      <p id="reading-note-{{.ID}}" class="project-reading-note" data-reading-note role="status" aria-live="polite" hidden></p>
    </article>
  </li>
  {{end}}
</ol>
{{else}}
<div class="empty-state">
  {{if and .Repositories.Filter.OnlyFocus (not .Repositories.Filter.Search) (not .Repositories.Filter.Tag) (not .Repositories.Filter.TopicSlug) (not .Repositories.Filter.Source)}}
  <h3>{{importText "empty_focus"}}</h3><p>{{importText "empty_focus_help"}}</p>
  {{else if .Repositories.Filter.OnlyNew}}
  <h3>{{tf "daily.empty_title" (formatDate .Repositories.Filter.AsOf)}}</h3><p>{{t "daily.empty_help"}}</p><a class="button button-secondary" href="{{.AllProjectsURL}}">{{if .Repositories.Filter.Tag}}{{t "tags.browse_all_matching"}}{{else}}{{t "daily.browse_all"}}{{end}}</a>
  {{else}}
  <h3>{{t "repositories.no_match"}}</h3><p>{{t "repositories.no_match_help"}}</p><a class="button button-secondary" href="{{.AllProjectsURL}}">{{t "repositories.clear_filters"}}</a>
  {{end}}
</div>
{{end}}
<nav class="cursor-pagination" aria-label="{{t "pagination.label"}}"><p>{{tf "repositories.page_summary" (formatInt (len .Repositories.Items)) (formatInt .Repositories.Total)}}</p><div>{{if .Repositories.Filter.AfterID}}<a class="button button-secondary" href="{{.Repositories.FirstPageURL}}">{{t "ui.first_page"}}</a>{{end}}{{if .Repositories.NextCursor}}<a class="button button-secondary" href="{{.Repositories.NextCursor}}" rel="next">{{t "pagination.next"}} {{template "icon-arrow"}}</a>{{end}}</div></nav>
<details class="method-note"><summary>{{t "ui.methodology"}}</summary><p>{{t "ui.methodology_help"}} <a class="text-link" href="/topics">{{t "ui.category_rules"}}</a></p><p>{{t "tags.method_note"}}</p><p>{{t "activity.age_help"}}</p><p>{{t "activity.incomplete"}}</p></details>
{{end}}
