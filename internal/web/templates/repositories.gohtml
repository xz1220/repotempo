{{define "content"}}
  <section class="page-controls" aria-labelledby="repository-filters">
    <h2 id="repository-filters" class="sr-only">{{t "repositories.filters"}}</h2>
    <form class="filter-bar" method="get" action="/repositories" role="search">
      <div class="field field-search">
        <label for="repository-search">{{t "repositories.search"}}</label>
        <input id="repository-search" name="q" type="search" value="{{.Repositories.Filter.Search}}" placeholder="{{t "repositories.search_placeholder"}}" autocomplete="off" spellcheck="false">
      </div>
      <div class="field">
        <label for="topic-filter">{{t "repositories.topic"}}</label>
        <select id="topic-filter" name="topic" data-submit-on-change>
          <option value="">{{t "repositories.all_topics"}}</option>
          {{range .Repositories.Topics}}
            <option value="{{.Slug}}" {{if eq $.Repositories.Filter.TopicSlug .Slug}}selected{{end}} translate="no">{{.Name}}</option>
          {{end}}
        </select>
      </div>
      <div class="field">
        <label for="source-filter">{{t "repositories.first_source"}}</label>
        <select id="source-filter" name="source" data-submit-on-change>
          <option value="">{{t "repositories.all_sources"}}</option>
          {{range .Repositories.Sources}}
            <option value="{{.}}" {{if eq $.Repositories.Filter.Source .}}selected{{end}}>{{sourceLabel .}}</option>
          {{end}}
        </select>
      </div>
      <div class="field">
        <label for="status-filter">{{t "repositories.monitoring"}}</label>
        <select id="status-filter" name="status" data-submit-on-change>
          <option value="">{{t "repositories.all_statuses"}}</option>
          {{range .Repositories.MonitoringStatuses}}
            <option value="{{.}}" {{if eq $.Repositories.Filter.MonitoringStatus .}}selected{{end}}>{{statusLabel .}}</option>
          {{end}}
        </select>
      </div>
      <div class="filter-actions">
        <button class="button button-primary" type="submit">{{t "repositories.apply_filters"}}</button>
        {{if or .Repositories.Filter.Search .Repositories.Filter.TopicSlug .Repositories.Filter.Source .Repositories.Filter.MonitoringStatus}}
          <a class="button button-secondary" href="/repositories">{{t "repositories.clear_filters"}}</a>
        {{end}}
      </div>
    </form>
  </section>

  <section class="page-primary-view" aria-labelledby="repository-results">
    <div class="section-heading result-heading">
      <div>
        <h2 id="repository-results">{{tf "repositories.count" (formatInt .Repositories.Total)}}</h2>
        <p>{{t "repositories.growth_help"}}</p>
      </div>
    </div>
    {{if .Repositories.Items}}
      <div class="table-scroll repository-table-scroll" role="region" aria-label="{{t "repositories.metrics_region"}}" tabindex="0">
        <table class="data-table repository-table">
          <thead>
            <tr>
              <th scope="col" class="repository-column repository-column--identity">{{t "repositories.repository"}}</th>
              <th scope="col" class="repository-column repository-column--stars numeric">{{t "metric.current_stars"}}</th>
              <th scope="col" class="repository-column repository-column--delta-1d numeric">{{t "metric.one_day"}}</th>
              <th scope="col" class="repository-column repository-column--delta-7d numeric">{{t "metric.seven_days"}}</th>
              <th scope="col" class="repository-column repository-column--delta-30d numeric">{{t "metric.thirty_days"}}</th>
              <th scope="col" class="repository-column repository-column--topics">{{t "metric.topics"}}</th>
              <th scope="col" class="repository-column repository-column--first-seen">{{t "repositories.first_seen"}}</th>
              <th scope="col" class="repository-column repository-column--status">{{t "repositories.monitoring"}}</th>
            </tr>
          </thead>
          <tbody>
            {{range $repository := .Repositories.Items}}
              <tr class="repository-record">
                <td class="repo-cell repository-cell repository-cell--identity mobile-essential" data-label="{{t "repositories.repository"}}">
                  <a class="repo-name" href="/repositories/{{.ID}}" translate="no">{{.FullName}}</a>
                  {{with githubURL .HTMLURL}}<a class="external-link" href="{{.}}" target="_blank" rel="noopener noreferrer" aria-label="{{tf "repositories.open_github_for" $repository.FullName}}">GitHub</a>{{end}}
                  {{if .Description}}<p class="repository-description">{{.Description}}</p>{{end}}
                </td>
                <td class="repository-cell repository-cell--stars mobile-essential numeric metric-value" data-label="{{t "metric.current_stars"}}">{{formatIntPtr .CurrentStars}}</td>
                <td class="repository-cell repository-cell--delta-1d numeric metric-delta" data-label="{{t "metric.one_day"}}">{{formatSigned .Delta1D}}</td>
                <td class="repository-cell repository-cell--delta-7d mobile-essential numeric metric-delta" data-label="{{t "metric.seven_days"}}">{{formatSigned .Delta7D}}</td>
                <td class="repository-cell repository-cell--delta-30d numeric metric-delta" data-label="{{t "metric.thirty_days"}}">{{formatSigned .Delta30D}}</td>
                <td class="repository-cell repository-cell--topics mobile-essential" data-label="{{t "metric.topics"}}">
                  <div class="tag-list">
                    {{range .Topics}}<a class="tag" href="/topics/{{.Slug}}" translate="no">{{.Name}}</a>{{else}}<span class="muted">{{t "repositories.unassigned"}}</span>{{end}}
                  </div>
                </td>
                <td class="repository-cell repository-cell--first-seen mobile-essential" data-label="{{t "repositories.first_seen"}}">
                  <span>{{sourceLabel .FirstSeenSource}}</span>
                  <time class="cell-secondary" datetime="{{.FirstSeenAt.Format "2006-01-02"}}">{{formatDate .FirstSeenAt}}</time>
                </td>
                <td class="repository-cell repository-cell--status" data-label="{{t "repositories.monitoring"}}"><span class="status-badge {{statusClass .MonitoringStatus}}"><span aria-hidden="true"></span>{{statusLabel .MonitoringStatus}}</span></td>
              </tr>
            {{end}}
          </tbody>
        </table>
      </div>
      <ol class="repository-record-list" aria-label="{{t "repositories.metrics_region"}}">
        {{range $repository := .Repositories.Items}}
          <li>
            <header class="repository-mobile-header">
              <div>
                <a class="repo-name" href="/repositories/{{.ID}}" translate="no">{{.FullName}}</a>
                {{if .Description}}<p class="repository-description">{{.Description}}</p>{{end}}
              </div>
              {{with githubURL .HTMLURL}}<a class="external-link" href="{{.}}" target="_blank" rel="noopener noreferrer" aria-label="{{tf "repositories.open_github_for" $repository.FullName}}">GitHub</a>{{end}}
            </header>
            <dl class="repository-mobile-metrics">
              <div><dt>{{t "metric.current_stars"}}</dt><dd class="metric-value">{{formatIntPtr .CurrentStars}}</dd></div>
              <div><dt>{{t "metric.seven_days"}}</dt><dd class="metric-delta">{{formatSigned .Delta7D}}</dd></div>
              <div class="repository-mobile-wide"><dt>{{t "metric.topics"}}</dt><dd><div class="tag-list">{{range .Topics}}<a class="tag" href="/topics/{{.Slug}}" translate="no">{{.Name}}</a>{{else}}<span class="muted">{{t "repositories.unassigned"}}</span>{{end}}</div></dd></div>
              <div class="repository-mobile-wide"><dt>{{t "repositories.first_seen"}}</dt><dd><span>{{sourceLabel .FirstSeenSource}}</span><time class="cell-secondary" datetime="{{.FirstSeenAt.Format "2006-01-02"}}">{{formatDate .FirstSeenAt}}</time></dd></div>
            </dl>
          </li>
        {{end}}
      </ol>
      {{template "pagination" .Pagination}}
    {{else}}
      <div class="empty-state">
        <h3>{{t "repositories.no_match"}}</h3>
        <p>{{t "repositories.no_match_help"}}</p>
        <a class="button button-secondary" href="/repositories">{{t "repositories.clear_filters"}}</a>
      </div>
    {{end}}
  </section>
{{end}}

{{define "pagination"}}
  {{if gt .Total 0}}
    <nav class="pagination" aria-label="{{t "pagination.label"}}">
      <p>{{tf "pagination.showing" (formatInt .Start) (formatInt .End) (formatInt .Total)}}</p>
      <div>
        {{if .PreviousURL}}<a class="button button-secondary" href="{{.PreviousURL}}" rel="prev">{{t "pagination.previous"}}</a>{{end}}
        {{if .NextURL}}<a class="button button-secondary" href="{{.NextURL}}" rel="next">{{t "pagination.next"}}</a>{{end}}
      </div>
    </nav>
  {{end}}
{{end}}
